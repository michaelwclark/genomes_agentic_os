{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic OS Library Registry",
  "type": "object",
  "required": ["libraries"],
  "properties": {
    "libraries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "source": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
