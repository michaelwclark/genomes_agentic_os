{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genomes-agentic-os.local/schemas/gui-snapshot.schema.json",
  "title": "AgenticOSGui Snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "root",
    "summary",
    "navigation",
    "conversations",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {"const": "agentic-os-gui/v1"},
    "generated_at": {"type": "string"},
    "root": {"type": "string"},
    "summary": {
      "type": "object",
      "required": ["conversations", "codex", "claude", "pinned", "unrouted"],
      "properties": {
        "conversations": {"type": "integer", "minimum": 0},
        "codex": {"type": "integer", "minimum": 0},
        "claude": {"type": "integer", "minimum": 0},
        "pinned": {"type": "integer", "minimum": 0},
        "unrouted": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "navigation": {
      "type": "object",
      "required": ["domains"],
      "properties": {
        "domains": {
          "type": "array",
          "items": {"$ref": "#/$defs/domain"}
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["status", "queue_mode", "queue_depth", "running", "failed", "dead_letter", "active_workers", "unhealthy_workers", "reserved_interactive_slots"],
      "properties": {
        "status": {"enum": ["healthy", "degraded", "critical", "unavailable"]},
        "queue_mode": {"type": "string"},
        "queue_depth": {"type": "integer", "minimum": 0},
        "running": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "dead_letter": {"type": "integer", "minimum": 0},
        "active_workers": {"type": "integer", "minimum": 0},
        "unhealthy_workers": {"type": "integer", "minimum": 0},
        "stale_queued": {"type": "integer", "minimum": 0},
        "expired_running_leases": {"type": "integer", "minimum": 0},
        "reserved_interactive_slots": {"type": "integer", "minimum": 1},
        "max_interactive_running": {"type": "integer", "minimum": 1},
        "queues": {"type": "array"},
        "worker_pools": {"type": "array"},
        "workers": {"type": "array"},
        "tasks": {"type": "array"},
        "task_count": {"type": "integer", "minimum": 0},
        "task_sample_count": {"type": "integer", "minimum": 0},
        "task_sample_limit": {"type": "integer", "minimum": 1},
        "long_running_runs": {
          "type": "array",
          "items": {"$ref": "#/$defs/long_running_run"}
        },
        "long_running_active": {"type": "integer", "minimum": 0},
        "long_running_attention": {"type": "integer", "minimum": 0},
        "captured_at": {"type": "string", "format": "date-time"},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "conversations": {
      "type": "array",
      "items": {"$ref": "#/$defs/conversation"}
    },
    "diagnostics": {
      "type": "array",
      "items": {"$ref": "#/$defs/diagnostic"}
    }
  },
  "$defs": {
    "long_running_run": {
      "type": "object",
      "required": ["id", "label", "status"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string"},
        "label": {"type": "string"},
        "status": {"type": "string"},
        "phase": {"type": "string"},
        "created_at": {"type": "string"},
        "started_at": {"type": ["string", "null"]},
        "updated_at": {"type": "string"},
        "finished_at": {"type": ["string", "null"]},
        "last_progress_at": {"type": ["string", "null"]},
        "pid": {"type": ["integer", "null"]},
        "monitor_pid": {"type": ["integer", "null"]},
        "run_dir": {"type": "string"},
        "work_dir": {"type": "string"},
        "exit_code": {"type": ["integer", "null"]},
        "terminal_reason": {"type": ["string", "null"]},
        "items_completed": {"type": "integer", "minimum": 0},
        "items_total": {"type": "integer", "minimum": 0},
        "files_completed": {"type": "integer", "minimum": 0},
        "files_total": {"type": "integer", "minimum": 0},
        "bytes_completed": {"type": "integer", "minimum": 0},
        "bytes_total": {"type": "integer", "minimum": 0},
        "output_bytes": {"type": "integer", "minimum": 0},
        "log_rotations": {"type": "integer", "minimum": 0},
        "checkpoint_strategy": {"type": "string"},
        "mutation_lock": {"type": ["string", "null"]},
        "terminal_receipt": {"type": "string"}
      },
      "additionalProperties": false
    },
    "domain": {
      "type": "object",
      "required": ["id", "name", "conversation_count", "projects"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "conversation_count": {"type": "integer", "minimum": 0},
        "projects": {
          "type": "array",
          "items": {"$ref": "#/$defs/project"}
        }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": ["id", "name", "domain", "status", "path", "conversation_count"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "domain": {"type": "string"},
        "status": {"type": "string"},
        "path": {"type": "string"},
        "conversation_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "conversation": {
      "type": "object",
      "required": [
        "key",
        "id",
        "native_id",
        "resume_id",
        "title",
        "harness",
        "provider",
        "model",
        "model_tier",
        "reasoning_effort",
        "status",
        "updated_at",
        "pinned",
        "can_continue",
        "jira_keys",
        "pull_requests",
        "slack_threads",
        "assets"
      ],
      "properties": {
        "key": {"type": "string", "pattern": "^(codex|claude):"},
        "id": {"type": "string"},
        "native_id": {"type": "string"},
        "resume_id": {"type": "string"},
        "cli_session_id": {"type": "string"},
        "title": {"type": "string", "minLength": 1},
        "harness": {"enum": ["codex", "claude", "unknown"]},
        "provider": {"enum": ["openai", "anthropic", "unknown"]},
        "model": {"type": "string"},
        "model_tier": {"enum": ["economy", "balanced", "frontier", "frontier_max", "human_gate", "unknown"]},
        "reasoning_effort": {"enum": ["low", "medium", "high", "xhigh", "max", "ultra", "unknown"]},
        "status": {"type": "string"},
        "created_at": {"type": "string"},
        "updated_at": {"type": "string"},
        "age": {"type": "string"},
        "domain": {"type": "string"},
        "project": {"type": "string"},
        "project_title": {"type": "string"},
        "project_root": {"type": "string"},
        "work_item": {"type": "string"},
        "route_confidence": {"enum": ["high", "medium", "low", "none"]},
        "route_source": {"type": "string"},
        "route_conflict": {"type": "boolean"},
        "cwd": {"type": "string"},
        "pinned": {"type": "boolean"},
        "pin_source": {"type": "string"},
        "can_continue": {"type": "boolean"},
        "imported": {"type": "boolean"},
        "continuation_note": {"type": "string"},
        "continuation": {
          "type": "object",
          "required": ["adapter", "session_id", "fallback_argv"],
          "properties": {
            "adapter": {"type": "string"},
            "session_id": {"type": "string"},
            "fallback_argv": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "jira_keys": {"type": "array", "items": {"type": "string"}},
        "jira_issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "url"],
            "properties": {
              "key": {"type": "string"},
              "url": {"type": "string", "format": "uri"},
              "title": {"type": "string"},
              "status": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "linear_issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "url"],
            "properties": {
              "key": {"type": "string"},
              "url": {"type": "string", "format": "uri"},
              "title": {"type": "string"},
              "status": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "pull_requests": {"type": "array", "items": {"type": "object"}},
        "slack_threads": {"type": "array", "items": {"type": "string"}},
        "assets": {"type": "array", "items": {"type": "object"}},
        "source": {"type": "string"}
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["severity", "message"],
      "properties": {
        "severity": {"enum": ["info", "warning", "error"]},
        "message": {"type": "string"},
        "source": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
