{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic OS Command Registry",
  "type": "object",
  "required": ["commands"],
  "properties": {
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "command", "description"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" },
          "description": { "type": "string" },
          "source": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
