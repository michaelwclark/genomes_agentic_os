{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genomes-agentic-os.local/schemas/auto-dev-review-receipt.schema.json",
  "title": "Auto-Dev coordinated review receipt",
  "type": "object",
  "required": [
    "schema",
    "key",
    "chain_key",
    "family_key",
    "status",
    "mode",
    "outcome",
    "subject",
    "parent_key",
    "review",
    "findings_ledger",
    "budget",
    "provider_post",
    "created_at",
    "completed_at"
  ],
  "properties": {
    "schema": {"const": "auto-dev-review-receipt/v1"},
    "key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chain_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "family_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"const": "completed"},
    "mode": {"enum": ["full", "delta"]},
    "outcome": {"enum": ["clean", "findings", "unavailable"]},
    "subject": {
      "type": "object",
      "required": [
        "repository",
        "pull_request",
        "base_branch",
        "base_sha",
        "head_sha",
        "policy_fingerprint",
        "purpose"
      ],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "pull_request": {"type": "string", "minLength": 1},
        "base_branch": {"type": "string", "minLength": 1},
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "policy_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "purpose": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "parent_key": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "review": {
      "type": "object",
      "required": ["outcome"],
      "properties": {
        "outcome": {"enum": ["clean", "findings", "unavailable"]}
      },
      "additionalProperties": true
    },
    "findings_ledger": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "budget": {
      "type": "object",
      "required": [
        "full_reviews_per_chain",
        "delta_reviews_per_chain",
        "absolute_full_reviews_per_family",
        "provider_posts_per_family",
        "full_reviews_used",
        "delta_reviews_used",
        "absolute_full_reviews_used",
        "provider_posts_used"
      ],
      "properties": {
        "full_reviews_per_chain": {"type": "integer", "minimum": 1},
        "delta_reviews_per_chain": {"type": "integer", "minimum": 0},
        "absolute_full_reviews_per_family": {"type": "integer", "minimum": 1},
        "provider_posts_per_family": {"type": "integer", "minimum": 0},
        "full_reviews_used": {"type": "integer", "minimum": 0},
        "delta_reviews_used": {"type": "integer", "minimum": 0},
        "absolute_full_reviews_used": {"type": "integer", "minimum": 0},
        "provider_posts_used": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "provider_post": {
      "type": "object",
      "required": ["status", "marker"],
      "properties": {
        "status": {"enum": ["not_requested", "failed", "posted"]},
        "marker": {
          "type": "string",
          "pattern": "^<!-- agentic-os-review:[0-9a-f]{64} -->$"
        },
        "result": {"type": "object"},
        "posted_at": {"type": "string", "format": "date-time"},
        "failed_at": {"type": "string", "format": "date-time"},
        "error": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "posted"}}},
          "then": {
            "required": ["result", "posted_at"],
            "properties": {
              "result": {
                "type": "object",
                "required": ["readback_verified"],
                "properties": {"readback_verified": {"const": true}},
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "failed"}}},
          "then": {"required": ["error", "failed_at"]}
        }
      ],
      "additionalProperties": false
    },
    "recovery": {
      "type": "object",
      "required": [
        "source_attempt_ref",
        "source_attempt_sha256",
        "evidence_ref",
        "recovered_at"
      ],
      "properties": {
        "source_attempt_ref": {"type": "string", "minLength": 1},
        "source_attempt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_ref": {"type": "string", "minLength": 1},
        "recovered_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "created_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "status", "severity", "summary", "evidence", "resolution"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{2,127}$"},
        "status": {"enum": ["open", "resolved"]},
        "severity": {"enum": ["blocking", "high", "medium", "low", "info"]},
        "summary": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "resolution": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["refs", "summary"],
              "properties": {
                "refs": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1},
                  "minItems": 1,
                  "uniqueItems": true
                },
                "summary": {"type": "string"}
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
