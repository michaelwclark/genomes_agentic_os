{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas-task-intake/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "atlas-task-intake/v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system": {
          "enum": [
            "chatgpt_cloud_automations",
            "explicit_user_requests"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "snapshot_scope": {
          "enum": [
            "complete_user_created",
            "partial"
          ]
        }
      },
      "required": [
        "system",
        "observed_at",
        "reference",
        "snapshot_scope"
      ]
    },
    "explicit_user_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "reference",
        "requested_at"
      ]
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attested_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "task_definitions_only": {
          "const": true
        },
        "excluded_sensitive_content": {
          "const": true
        }
      },
      "required": [
        "attested_by",
        "task_definitions_only",
        "excluded_sensitive_content"
      ]
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/cloud_task"
          },
          {
            "$ref": "#/$defs/request_task"
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "source",
    "explicit_user_request",
    "privacy",
    "tasks"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "system": {
                "const": "explicit_user_requests"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "tasks": {
            "items": {
              "$ref": "#/$defs/request_task"
            }
          }
        }
      },
      "else": {
        "properties": {
          "tasks": {
            "items": {
              "$ref": "#/$defs/cloud_task"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "ownership": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scope": {
              "const": "root"
            }
          },
          "required": [
            "scope"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scope": {
              "const": "domain"
            },
            "domain": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,99}$"
            }
          },
          "required": [
            "scope",
            "domain"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scope": {
              "const": "project"
            },
            "domain": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,99}$"
            },
            "project": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,99}$"
            }
          },
          "required": [
            "scope",
            "domain",
            "project"
          ]
        }
      ]
    },
    "component_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "workflow",
            "prompt",
            "skill",
            "schedule",
            "automation",
            "program",
            "command"
          ]
        },
        "reference": {
          "type": "string",
          "pattern": "^[a-z]+:[a-zA-Z0-9:_-]{1,200}$"
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^https://[^/?#@\\s]+(?:/[^?#\\s]*)?$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)(?:\\.|\\.\\.|\\.git)(?:/|$))(?!.*//)(?!.*\\/$).+$"
        },
        "revision": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            }
          ]
        },
        "sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        },
        "ownership": {
          "$ref": "#/$defs/ownership"
        },
        "verification": {
          "enum": [
            "unverified",
            "source_verified"
          ]
        }
      },
      "required": [
        "kind",
        "reference",
        "repository",
        "path",
        "revision",
        "sha256",
        "ownership",
        "verification"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "workflow"
              }
            }
          },
          "then": {
            "properties": {
              "reference": {
                "pattern": "^workflow:"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "prompt"
              }
            }
          },
          "then": {
            "properties": {
              "reference": {
                "pattern": "^prompt:"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "skill"
              }
            }
          },
          "then": {
            "properties": {
              "reference": {
                "pattern": "^skill:"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "schedule"
              }
            }
          },
          "then": {
            "properties": {
              "reference": {
                "pattern": "^schedule:"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "automation"
              }
            }
          },
          "then": {
            "properties": {
              "reference": {
                "pattern": "^automation:"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "program"
              }
            }
          },
          "then": {
            "properties": {
              "reference": {
                "pattern": "^program:"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "command"
              }
            }
          },
          "then": {
            "properties": {
              "reference": {
                "pattern": "^command:"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verification": {
                "const": "source_verified"
              }
            }
          },
          "then": {
            "properties": {
              "revision": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "channel_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspace_id": {
          "type": "string",
          "pattern": "^T[A-Z0-9]{8,32}$"
        },
        "channel_id": {
          "type": "string",
          "pattern": "^[CG][A-Z0-9]{8,32}$"
        },
        "relation": {
          "enum": [
            "origin",
            "destination"
          ]
        },
        "verification": {
          "enum": [
            "user_defined",
            "unverified",
            "provider_verified"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "workspace_id",
        "channel_id",
        "relation",
        "verification",
        "evidence_ref"
      ]
    },
    "cloud_task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000
        },
        "registration_status": {
          "enum": [
            "registered",
            "pending_approval",
            "blocked",
            "canceled"
          ]
        },
        "destinations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "verification": {
                "enum": [
                  "user_defined",
                  "unverified",
                  "provider_verified"
                ]
              }
            },
            "required": [
              "kind",
              "reference",
              "verification"
            ]
          }
        },
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inputs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "minItems": 1,
              "maxItems": 30
            },
            "process": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "minItems": 1,
              "maxItems": 30
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "minItems": 1,
              "maxItems": 30
            },
            "review": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "minItems": 1,
              "maxItems": 30
            },
            "handoff": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "minItems": 1,
              "maxItems": 30
            }
          },
          "required": [
            "inputs",
            "process",
            "outputs",
            "review",
            "handoff"
          ]
        },
        "is_enabled": {
          "type": "boolean"
        },
        "default_timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "timing_mode": {
          "enum": [
            "flexible_schedule",
            "exact_schedule",
            "condition_watch"
          ]
        },
        "schedule": {
          "type": "string",
          "pattern": "^BEGIN:VEVENT\\n[\\s\\S]+\\nEND:VEVENT$",
          "maxLength": 2000
        },
        "start": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "verification": {
              "const": "unverified"
            },
            "known_user_scope": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "parameters": {
              "type": "null"
            }
          },
          "required": [
            "kind",
            "verification",
            "known_user_scope",
            "parameters"
          ]
        },
        "next_run_time": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "ownership": {
          "$ref": "#/$defs/ownership"
        },
        "component_bindings": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/component_binding"
          }
        },
        "channel_bindings": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/channel_binding"
          }
        }
      },
      "required": [
        "id",
        "title",
        "prompt",
        "registration_status",
        "destinations",
        "workflow",
        "is_enabled",
        "default_timezone",
        "timing_mode",
        "schedule"
      ]
    },
    "request_task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000
        },
        "registration_status": {
          "enum": [
            "registered",
            "pending_approval",
            "blocked",
            "canceled"
          ]
        },
        "destinations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "verification": {
                "enum": [
                  "user_defined",
                  "unverified",
                  "provider_verified"
                ]
              }
            },
            "required": [
              "kind",
              "reference",
              "verification"
            ]
          }
        },
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inputs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "minItems": 1,
              "maxItems": 30
            },
            "process": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "minItems": 1,
              "maxItems": 30
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "minItems": 1,
              "maxItems": 30
            },
            "review": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "minItems": 1,
              "maxItems": 30
            },
            "handoff": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "minItems": 1,
              "maxItems": 30
            }
          },
          "required": [
            "inputs",
            "process",
            "outputs",
            "review",
            "handoff"
          ]
        },
        "prompt_capture": {
          "enum": [
            "exact_user_prompt",
            "summary_only"
          ]
        },
        "components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "minItems": 1,
          "maxItems": 30
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "minItems": 1,
          "maxItems": 30
        },
        "ownership": {
          "$ref": "#/$defs/ownership"
        },
        "component_bindings": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/component_binding"
          }
        },
        "channel_bindings": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/channel_binding"
          }
        }
      },
      "required": [
        "id",
        "title",
        "prompt",
        "registration_status",
        "destinations",
        "workflow",
        "prompt_capture",
        "components",
        "dependencies"
      ]
    }
  }
}
