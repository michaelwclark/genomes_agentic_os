{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic OS Capability Registry",
  "type": "object",
  "required": ["capabilities"],
  "properties": {
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "ref", "name"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["command", "skill", "mcp_server", "library", "hook", "plugin", "rule"]
          },
          "ref": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
