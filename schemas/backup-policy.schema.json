{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic OS Backup Policy",
  "type": "object",
  "required": ["backup_policy"],
  "properties": {
    "backup_policy": {
      "type": "object",
      "required": ["enabled", "include", "exclude", "remote"],
      "properties": {
        "enabled": { "type": "boolean" },
        "include": {
          "type": "array",
          "items": { "type": "string" }
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string" }
        },
        "remote": {
          "type": "object",
          "required": ["name", "url"],
          "properties": {
            "name": { "type": "string" },
            "url": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
