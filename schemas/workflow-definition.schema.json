{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genomes.dev/agentic-os/workflow-definition.schema.json",
  "title": "Agentic OS WorkflowDefinition",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "resource_kind",
    "id",
    "domain",
    "lane",
    "name",
    "summary",
    "owner",
    "availability",
    "health",
    "version",
    "inputs",
    "outputs",
    "approvals",
    "retry",
    "failure_policy",
    "prompts",
    "agents",
    "models",
    "linked_capabilities",
    "publish",
    "steps"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "resource_kind": {"const": "workflow_definition"},
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "domain": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "lane": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
    "owner": {"type": "string", "minLength": 1, "maxLength": 160},
    "availability": {"enum": ["draft", "active", "paused", "archived"]},
    "health": {"enum": ["healthy", "degraded", "blocked", "unknown"]},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"},
    "inputs": {"type": "object"},
    "outputs": {"type": "object"},
    "approvals": {"type": "array"},
    "retry": {
      "type": "object",
      "additionalProperties": true,
      "required": ["max_attempts", "backoff_seconds"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "backoff_seconds": {"type": "integer", "minimum": 0, "maximum": 86400}
      }
    },
    "failure_policy": {"enum": ["stop", "continue", "retry", "require_approval"]},
    "prompts": {"type": "array"},
    "agents": {"type": "array"},
    "models": {"type": "array"},
    "execution": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "harness": {"enum": ["agentic_os", "codex", "claude"]}
      }
    },
    "linked_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["kind", "id"],
        "properties": {
          "kind": {"enum": ["skill", "command", "program", "automation", "workflow"]},
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"}
        }
      }
    },
    "publish": {
      "type": "object",
      "additionalProperties": true,
      "required": ["allowed"],
      "properties": {"allowed": {"type": "boolean"}}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "name", "summary", "order", "kind", "depends_on", "inputs", "outputs", "approvals", "retry", "failure_policy"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 160},
          "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
          "order": {"type": "integer", "minimum": 1},
          "kind": {"enum": ["prompt", "skill", "command", "approval", "manual", "workflow", "automation", "program"]},
          "depends_on": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
          "prompt": {"type": "string", "maxLength": 100000},
          "agent": {"type": ["string", "null"], "maxLength": 160},
          "model": {"type": ["string", "null"], "maxLength": 160},
          "complexity": {"type": ["string", "null"], "maxLength": 80},
          "skills": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
          "commands": {"type": "array", "items": {"type": "string"}},
          "inputs": {"type": "object"},
          "outputs": {"type": "object"},
          "approvals": {"type": "array"},
          "retry": {"$ref": "#/$defs/retry"},
          "failure_policy": {"enum": ["stop", "continue", "retry", "require_approval"]}
        }
      }
    }
  },
  "$defs": {
    "retry": {
      "type": "object",
      "additionalProperties": true,
      "required": ["max_attempts", "backoff_seconds"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "backoff_seconds": {"type": "integer", "minimum": 0, "maximum": 86400}
      }
    }
  }
}
