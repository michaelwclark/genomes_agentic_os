    "inspectionRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "payload": {
          "$ref": "#/$defs/inspectionPayload"
        },
        "signature": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==$(?![\\s\\S])"
        }
      },
      "required": [
        "payload",
        "signature"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "execution-fabric-cold-recovery-policy/v1"
        },
        "enabled": {
          "type": "boolean"
        },
        "clusterId": {
          "type": "string",
          "minLength": 1
        },
        "allowedHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._-]{1,128}$(?![\\s\\S])"
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "recoveryPublicKeyPem": {
          "type": [
            "string",
            "null"
          ]
        },
        "fencePublicKeyPem": {
          "type": [
            "string",
            "null"
          ]
        },
        "maxApprovalSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600
        },
        "witnessActorSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "controlPlaneActorSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "selectiveDisposition": {
          "$ref": "#/$defs/selectiveDisposition"
        }
      },
      "required": [
        "schemaVersion",
        "enabled",
        "clusterId",
        "allowedHosts",
        "recoveryPublicKeyPem",
        "fencePublicKeyPem",
        "maxApprovalSeconds",
        "witnessActorSha256",
        "controlPlaneActorSha256"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "recoveryPublicKeyPem": {
                "type": "string",
                "minLength": 1
              },
              "fencePublicKeyPem": {
                "type": "string",
                "minLength": 1
              },
              "witnessActorSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
              },
              "controlPlaneActorSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
              }
            }
          }
        }
      ]
    },
    "selectiveDisposition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "acceptedPolicySha256": {
          "anyOf": [
