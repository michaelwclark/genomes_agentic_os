          "maxLength": 64
        },
        "beforeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])",
          "minLength": 64,
          "maxLength": 64
        },
        "afterSha256": {
          "type": "string",
