        "authority": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "backend": {
                  "const": "sqlite"
                },
                "databasePath": {
                  "type": "string",
                  "pattern": "^/(?!\\.\\.?(/|$))(?!.*\\/\\.\\.?(\\/|$))(?!.*\\/\\/)(?:[^/]+(?:/[^/]+)*)?$(?![\\s\\S])",
                  "minLength": 1
                },
                "domain": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "project": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "required": [
                "backend",
                "databasePath",
                "domain",
                "project"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "executionPolicyFile": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^/(?!\\.\\.?(/|$))(?!.*\\/\\.\\.?(\\/|$))(?!.*\\/\\/)(?:[^/]+(?:/[^/]+)*)?$(?![\\s\\S])",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "allowedLocalTaskTypes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_.-]*$(?![\\s\\S])"
          }
        },
        "heldProviders": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*$(?![\\s\\S])"
          }
        }
      },
      "required": [
        "enabled",
        "acceptedPolicySha256",
        "sourceRelease",
        "authority",
        "executionPolicyFile",
        "allowedLocalTaskTypes",
        "heldProviders"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "acceptedPolicySha256": {
                "not": {
                  "type": "null"
                }
              },
              "sourceRelease": {
                "not": {
                  "type": "null"
                }
              },
              "authority": {
                "not": {
                  "type": "null"
                }
              },
              "executionPolicyFile": {
                "not": {
                  "type": "null"
                }
              }
