{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic OS Skill Visibility Registry",
  "description": "Visible skill inventory installed at harness/registries/skills.yml. The richer distribution registry at harness/skills/skill-registry.yml is governed by skill-registry.schema.json.",
  "type": "object",
  "required": ["skills"],
  "properties": {
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
