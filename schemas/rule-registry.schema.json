{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agentic OS Rule Registry",
  "type": "object",
  "required": ["rules"],
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "source"],
        "properties": {
          "id": { "type": "string" },
          "key": { "type": "string", "description": "Shared conflict identity across scopes; defaults to id." },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "summary": { "type": "string" },
          "source": { "type": "string" },
          "scope": { "enum": ["system", "os", "domain", "project", "workflow", "automation"] },
          "effect": { "enum": ["inform", "allow", "prefer", "require", "deny"] },
          "strictness": { "type": "integer", "minimum": 0, "maximum": 100 },
          "body_markdown": { "type": "string" },
          "references": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
