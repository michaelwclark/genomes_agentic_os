{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genomes-agentic-os.local/schemas/auto-dev-health-evidence.schema.json",
  "title": "Auto-Dev Health evidence",
  "type": "object",
  "required": ["schema", "work_item_id", "stage", "status", "summary", "subject_revision", "terminal_revision", "evidence", "verified_at"],
  "properties": {
    "schema": {"const": "auto-dev-health-evidence/v1"},
    "work_item_id": {"type": "string", "minLength": 1},
    "stage": {"const": "health"},
    "status": {"const": "completed"},
    "summary": {"type": "string", "minLength": 1},
    "subject_revision": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
    "terminal_revision": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
    "verified_at": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "object",
      "required": ["preflight_ref", "receipt_refs", "terminal_authority", "receipt_audit", "resources", "work_state", "closed_worktree_registry_ref", "active_index_refs", "validation_results", "residual_holds"],
      "properties": {
        "preflight_ref": {"type": "string", "minLength": 1},
        "receipt_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "terminal_authority": {
          "type": "object",
          "required": ["kind", "provider", "ref", "revision", "verified_at"],
          "properties": {
            "kind": {"const": "pull_request_merge"},
            "provider": {"type": "string", "minLength": 1},
            "ref": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
            "verified_at": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "receipt_audit": {
          "type": "object",
          "required": ["required", "present", "missing", "resume_ready"],
          "properties": {
            "required": {
              "type": "array",
              "minItems": 10,
              "maxItems": 10,
              "uniqueItems": true,
              "items": {
                "enum": ["terminal_authority", "closeout", "receipt_audit", "resume_manifest", "packet_manifest", "resource_cleanup", "runtime_cleanup", "work_state", "active_index", "validation"]
              }
            },
            "present": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["kind", "ref", "sha256"],
                "properties": {
                  "kind": {
                    "enum": ["terminal_authority", "closeout", "receipt_audit", "resume_manifest", "packet_manifest", "resource_cleanup", "runtime_cleanup", "work_state", "active_index", "validation"]
                  },
                  "ref": {"type": "string", "minLength": 1},
                  "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
                },
                "additionalProperties": false
              }
            },
            "missing": {"type": "array", "maxItems": 0},
            "resume_ready": {"const": true}
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object",
          "required": ["worktree", "runtime"],
          "properties": {
            "worktree": {"$ref": "#/$defs/resourceDisposition"},
            "runtime": {"$ref": "#/$defs/resourceDisposition"}
          },
          "additionalProperties": false
        },
        "work_state": {
          "type": "object",
          "required": ["canonical_work_id", "before", "before_attention", "after", "history_receipt", "packet_old_path", "packet_new_path"],
          "properties": {
            "canonical_work_id": {"type": "string", "minLength": 1},
            "before": {"type": "string", "minLength": 1},
            "before_attention": {"type": "string", "minLength": 1},
            "after": {"const": "finished"},
            "history_receipt": {"type": "string", "minLength": 1},
            "packet_old_path": {"type": "string", "minLength": 1},
            "packet_new_path": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "closed_worktree_registry_ref": {"type": "string", "minLength": 1},
        "active_index_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "validation_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["command", "result", "ref"],
            "properties": {
              "command": {"type": "string", "minLength": 1},
              "result": {"const": "passed"},
              "ref": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "residual_holds": {"type": "array", "maxItems": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "resourceDisposition": {
      "type": "object",
      "required": ["identity", "preflight", "action", "result", "receipt"],
      "properties": {
        "identity": {"type": "string", "minLength": 1},
        "preflight": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "result": {"enum": ["removed", "absent", "not_managed"]},
        "receipt": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
