<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.genomes.agentic-os.execution-fabric.recovery-backup</string>
  <key>ProgramArguments</key>
  <array><string>__INSTALL_ROOT__/bin/recovery-collect.sh</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>FABRIC_RUNTIME_ENV_FILE</key><string>__RUNTIME_ENV__</string></dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>30</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>KeepAlive</key><false/>
  <key>StandardOutPath</key><string>__STATE_DIR__/logs/recovery-backup.log</string>
  <key>StandardErrorPath</key><string>__STATE_DIR__/logs/recovery-backup.error.log</string>
</dict>
</plist>
