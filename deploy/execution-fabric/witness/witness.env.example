# Copy to an operator-owned witness.env outside the repository.
WITNESS_MODE=independent
WITNESS_HOST_ID=witness-1
WITNESS_TAILSCALE_IP=
WITNESS_PORT=3195
WITNESS_CLUSTER_ID=agentic-os-production
WITNESS_STORE=sqlite
WITNESS_STATE_DIR=/var/lib/genomes-agentic-os/execution-fabric-witness
WITNESS_STATE_FILE=/var/lib/execution-fabric-witness/witness.sqlite3
WITNESS_INITIAL_LEADER=genomesbox
WITNESS_INITIAL_TIMELINE_ID=1
WITNESS_INITIAL_CONFIG_DIGEST=
WITNESS_MAX_REPLICA_LAG_BYTES=67108864
WITNESS_CANDIDATE_FRESHNESS_SECONDS=90
WITNESS_LEADER_BASELINE_MAX_AGE_SECONDS=300
WITNESS_PLAN_TTL_SECONDS=900
WITNESS_MAX_REPORT_SKEW_SECONDS=30
WITNESS_ALLOW_DEGRADED_PRIMARY=false
WITNESS_MAX_DEGRADED_PRIMARY_SECONDS=3600
WITNESS_READER_TOKEN_FILE=/etc/genomes-agentic-os/execution-fabric-witness/secrets/reader-token
WITNESS_CANDIDATE_TOKENS_FILE=/etc/genomes-agentic-os/execution-fabric-witness/secrets/candidate-tokens.json
WITNESS_ADMIN_TOKEN_FILE=/etc/genomes-agentic-os/execution-fabric-witness/secrets/admin-token
WITNESS_SIGNING_PRIVATE_KEY_FILE=/etc/genomes-agentic-os/execution-fabric-witness/secrets/signing-private-key.pem
WITNESS_LOG_LEVEL=info
WITNESS_CONTAINER_RUNTIME=docker
WITNESS_CONTAINER_NAME=genomes-agentic-os-execution-fabric-witness
WITNESS_RUNTIME_STATE_DIR=/var/lib/genomes-agentic-os/execution-fabric-witness/monitor
WITNESS_OS_ROOT=/home/genome/agentic_os
FABRIC_WITNESS_IMAGE=
# These must remain false in manual_fail_closed mode.
FABRIC_AUTO_FAILOVER=false
FABRIC_ENABLE_PROMOTION=false

# Optional DynamoDB adapter. SQLite is the portable default.
# WITNESS_STORE=dynamodb
# WITNESS_TABLE_NAME=genomes-agentic-os-execution-fabric-witness
# AWS_REGION=us-east-1
