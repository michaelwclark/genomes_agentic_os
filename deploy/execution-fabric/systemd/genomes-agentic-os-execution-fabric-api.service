[Unit]
Description=Genomes Agentic OS Execution Fabric API role
After=docker.service network-online.target genomes-agentic-os-execution-fabric-primary.service
Requires=docker.service genomes-agentic-os-execution-fabric-primary.service
PartOf=genomes-agentic-os-execution-fabric-primary.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/genomes-agentic-os/execution-fabric/runtime.env
WorkingDirectory=/opt/genomes-agentic-os/execution-fabric/current/deploy
ExecStart=/usr/bin/docker compose --env-file /etc/genomes-agentic-os/execution-fabric/runtime.env -f compose.genomesbox.yml --profile primary up -d --no-deps control-plane
ExecStartPost=/opt/genomes-agentic-os/execution-fabric/current/installers/bin/wait-ready.sh
ExecStop=/usr/bin/docker compose --env-file /etc/genomes-agentic-os/execution-fabric/runtime.env -f compose.genomesbox.yml stop control-plane
TimeoutStartSec=120
TimeoutStopSec=60
