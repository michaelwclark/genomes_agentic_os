[Unit]
Description=Check Execution Fabric primary and trigger fenced HA workflow
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/genomes-agentic-os/execution-fabric/runtime.env
ExecStart=/opt/genomes-agentic-os/execution-fabric/current/installers/bin/watchdog.sh
NoNewPrivileges=true
PrivateTmp=true
