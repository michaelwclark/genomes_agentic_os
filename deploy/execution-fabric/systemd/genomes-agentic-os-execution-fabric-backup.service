[Unit]
Description=Create and verify an Execution Fabric PostgreSQL backup
Requires=genomes-agentic-os-execution-fabric-primary.service
After=genomes-agentic-os-execution-fabric-primary.service

[Service]
Type=oneshot
EnvironmentFile=/etc/genomes-agentic-os/execution-fabric/runtime.env
WorkingDirectory=/opt/genomes-agentic-os/execution-fabric/current/deploy
ExecStart=/opt/genomes-agentic-os/execution-fabric/current/installers/bin/backup-health.sh
NoNewPrivileges=true
TimeoutStartSec=600
