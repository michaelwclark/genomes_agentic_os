# Non-secret deployment selectors only. Copy to the canonical host runtime path.
FABRIC_DEPLOYMENT_ROLE=primary
FABRIC_HOST_ID=genomesbox
# Stable identities are topology configuration, not script constants. Both
# hosts must carry the same pair with their own FABRIC_HOST_ID.
FABRIC_PRIMARY_HOST_ID=genomesbox
FABRIC_STANDBY_HOST_ID=bigmac
FABRIC_TAILSCALE_IP=
FABRIC_PRIMARY_TAILSCALE_IP=
FABRIC_STANDBY_TAILSCALE_IP=
FABRIC_POSTGRES_REPLICATION_PORT=35432
FABRIC_API_BASE=
FABRIC_PRIMARY_API_BASE=
FABRIC_CONTROL_PLANE_IMAGE=
FABRIC_WITNESS_IMAGE=
FABRIC_WORKER_IMAGE=
FABRIC_POSTGRES_IMAGE=
FABRIC_VALKEY_IMAGE=
FABRIC_MINIO_IMAGE=
FABRIC_MINIO_CLIENT_IMAGE=
FABRIC_POSTGRES_USER=fabric
FABRIC_POSTGRES_DB=execution_fabric
FABRIC_MINIO_ROOT_USER=
FABRIC_ARTIFACT_ENDPOINT=http://minio:9000
FABRIC_ARTIFACT_REGION=us-east-1
FABRIC_ARTIFACT_BUCKET=execution-fabric-artifacts
FABRIC_ARTIFACT_ACCESS_KEY_FILE=
FABRIC_ARTIFACT_SECRET_KEY_FILE=
FABRIC_ARTIFACT_FORCE_PATH_STYLE=true
FABRIC_ARTIFACT_UPLOAD_TTL_SECONDS=300
FABRIC_ARTIFACT_DOWNLOAD_TTL_SECONDS=300
FABRIC_ARTIFACT_MAX_BYTES=10485760
FABRIC_ARTIFACT_RETENTION_DAYS=30
FABRIC_MINIO_PRIMARY_URL=
FABRIC_MINIO_STANDBY_URL=
FABRIC_MINIO_ROOT_USER_FILE=
FABRIC_MINIO_ROOT_PASSWORD_FILE=
FABRIC_ARTIFACT_REPLICATION_MAX_LAG_SECONDS=60
FABRIC_ARTIFACT_REPLICATION_RECEIPT_MAX_AGE_SECONDS=300
FABRIC_QUEUE_PREFIX=agentic-os:fabric
FABRIC_ADMIN_TOKEN_FILE=
FABRIC_API_TOKEN_FILE=
FABRIC_SUBMIT_TOKEN_FILE=
FABRIC_WORKER_BOOTSTRAP_CREDENTIALS_FILE=
FABRIC_RELIABILITY_SOURCE_TOKENS_FILE=
FABRIC_EFFECT_CONSUMER_CREDENTIALS_FILE=
FABRIC_ALARM_DISPATCHER_CREDENTIALS_FILE=
FABRIC_ALARM_DISPATCHER_TOKEN_FILE=
FABRIC_ALARM_DISPATCHER_CONSUMER_ID=standby-agentic-os-notifier
FABRIC_ALARM_DISPATCHER_SOURCE=agentic-os-notify
# independent: third-host HA witness; standalone_primary: genomesbox-only
# signed non-HA authority; manual_fail_closed: no managed remote activation.
FABRIC_WITNESS_MODE=independent
FABRIC_LEADERSHIP_API_BASE=
# Container-only route; standalone_primary uses http://leadership-witness:3195.
FABRIC_LEADERSHIP_CONTAINER_API_BASE=
FABRIC_LEADERSHIP_TOKEN_FILE=
FABRIC_LEADERSHIP_CANDIDATE_TOKEN_FILE=
FABRIC_LEADERSHIP_CANDIDATE_TOKENS_FILE=
FABRIC_LEADERSHIP_ADMIN_TOKEN_FILE=
FABRIC_LEADERSHIP_PUBLIC_KEY_FILE=
FABRIC_LEADERSHIP_SIGNING_PRIVATE_KEY_FILE=
FABRIC_LEADERSHIP_RECEIPT_FILE=
FABRIC_CLUSTER_ID=agentic-os-production
FABRIC_POLICY_FINGERPRINT=
# Keep false. The Linux primary runner grants bootstrap only for the first
# bounded witness start, records a host marker, then recreates without it.
FABRIC_STANDALONE_WITNESS_BOOTSTRAP_ONCE=false
FABRIC_STANDALONE_INITIAL_TIMELINE_ID=1
FABRIC_STANDALONE_PROOF_TTL_SECONDS=90
FABRIC_LEADERSHIP_REFRESH_MS=10000
FABRIC_LEADERSHIP_RECOVERY_HOLD_SECONDS=30
FABRIC_GATEWAY_API_BASE=
FABRIC_PRIMARY_SSH_TARGET=
FABRIC_REMOTE_INSTALLER_DIR=
FABRIC_RUNTIME_STATE_DIR=
FABRIC_OS_ROOT=
FABRIC_AGENTIC_OS_CLI=
FABRIC_DEPLOYMENT_DIR=
FABRIC_SECRETS_DIR=
FABRIC_EMERGENCY_BUNDLE_DIR=
FABRIC_WORKER_EXECUTABLE=
FABRIC_WORKER_PYTHON=python3
FABRIC_WORKER_ID=
FABRIC_WORKER_BOOTSTRAP_ID=
FABRIC_WORKER_POOL_ID=
FABRIC_WORKER_ACCEPTED_QUEUES=
FABRIC_WORKER_CAPABILITIES=
FABRIC_WORKER_MAX_CONCURRENCY=2
FABRIC_WORKER_HEARTBEAT_SECONDS=15
FABRIC_WORKER_SPOOL_DRAIN_SECONDS=30
AGENTIC_OS_EXECUTION_FABRIC_WORKER_TOKEN_FILE=
FABRIC_AUTO_FAILOVER=false
FABRIC_ENABLE_PROMOTION=false
FABRIC_ALLOW_DEGRADED_PRIMARY=false
FABRIC_DEGRADED_PRIMARY_MAX_SECONDS=3600
# Must be ${FABRIC_RUNTIME_STATE_DIR}/backup-health.json on the primary.
FABRIC_BACKUP_HEALTH_RECEIPT_FILE=
FABRIC_BACKUP_HEALTH_RECEIPT_MAX_AGE_SECONDS=86400
FABRIC_MAX_REPLICA_LAG_BYTES=67108864
FABRIC_CANDIDATE_REPORT_INTERVAL_SECONDS=30
FABRIC_CANDIDATE_HEARTBEAT_MAX_AGE_SECONDS=75
FABRIC_FAILURE_THRESHOLD=2
FABRIC_ALERT_COOLDOWN_SECONDS=300
FABRIC_ALARM_DISPATCH_LIMIT=20
FABRIC_OBSERVER_INTERVAL_MS=15000
FABRIC_ROLE_HEALTH_FAILURE_THRESHOLD=3
FABRIC_ROLE_HEALTH_MAX_AGE_SECONDS=60
FABRIC_HEALER_INTERVAL_MS=15000
FABRIC_HEALER_COOLDOWN_SECONDS=60
FABRIC_HEALER_MAX_REPAIRS_PER_HOUR=30
FABRIC_HEALER_ALLOW_ACTIONS=reconcile_expired_attempts,reconstruct_delivery,recover_effect_claim
FABRIC_SCHEDULER_INTERVAL_MS=15000
FABRIC_SCHEDULER_BATCH_SIZE=20
FABRIC_BACKUP_RETENTION_DAYS=14
