{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["replicaCount", "image", "fabric", "secrets", "worker", "storage", "network"],
  "properties": {
    "replicaCount": {"const": 1},
    "image": {
      "type": "object",
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["IfNotPresent", "Never"]}
      }
    },
    "fabric": {
      "type": "object",
      "required": ["apiBase", "apiVersion"],
      "properties": {
        "apiBase": {"type": "string", "pattern": "^https?://"},
        "apiVersion": {"const": "v1"}
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "keys"],
      "properties": {
        "existingSecret": {"type": "string"},
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workerBootstrapToken"],
          "properties": {
            "workerBootstrapToken": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+$"
            }
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "required": [
        "id",
        "bootstrapId",
        "hostId",
        "acceptedQueues",
        "capabilities",
        "maxConcurrency",
        "heartbeatSeconds",
        "spoolDrainSeconds",
        "gracefulShutdownSeconds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._:-]{1,128}$"
        },
        "bootstrapId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._:-]{1,128}$"
        },
        "hostId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._:-]{1,128}$"
        },
        "acceptedQueues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "maxConcurrency": {"type": "integer", "minimum": 1},
        "heartbeatSeconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "spoolDrainSeconds": {"type": "integer", "minimum": 5, "maximum": 3600},
        "gracefulShutdownSeconds": {"type": "integer", "minimum": 10}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingClaim"],
      "properties": {
        "existingClaim": {"type": "string", "minLength": 1}
      }
    },
    "network": {
      "type": "object",
      "required": ["fabricCidrs", "fabricPort"],
      "properties": {
        "fabricCidrs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "fabricPort": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "resources": {"type": "object"},
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "tolerations": {"type": "array", "items": {"type": "object"}},
    "affinity": {"type": "object"}
  },
  "additionalProperties": false
}
