{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-os.local/schemas/execution-fabric-queue-config-v1.json",
  "title": "Execution Fabric queue catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "enabled", "admission", "queues"],
  "properties": {
    "schema_version": {"const": 1},
    "enabled": {"type": "boolean"},
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global_max_running", "reserved_interactive_slots"],
      "properties": {
        "global_max_running": {"type": "integer", "minimum": 1},
        "reserved_interactive_slots": {"type": "integer", "minimum": 0}
      }
    },
    "queues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "enabled", "worker_pool", "accepted_task_types", "priority", "concurrency"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "enabled": {"type": "boolean"},
          "worker_pool": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "accepted_task_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "priority": {"type": "integer", "minimum": 0, "maximum": 100},
          "concurrency": {
            "type": "object",
            "additionalProperties": false,
            "required": ["max_running", "max_queued"],
            "properties": {
              "max_running": {"type": "integer", "minimum": 1},
              "max_queued": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    }
  }
}
