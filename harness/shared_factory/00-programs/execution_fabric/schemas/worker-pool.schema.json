{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-os.local/schemas/execution-fabric-worker-pools-v1.json",
  "title": "Execution Fabric worker pools",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "enabled", "worker_pools"],
  "properties": {
    "schema_version": {"const": 1},
    "enabled": {"type": "boolean"},
    "worker_pools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "enabled", "provider", "queues", "capacity", "lease", "retry"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "enabled": {"type": "boolean"},
          "provider": {"enum": ["codex", "claude", "non_llm"]},
          "queues": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
          "capacity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["min_workers", "max_workers", "max_tasks_per_worker"],
            "properties": {
              "min_workers": {"type": "integer", "minimum": 0},
              "max_workers": {"type": "integer", "minimum": 1},
              "max_tasks_per_worker": {"type": "integer", "minimum": 1}
            }
          },
          "lease": {
            "type": "object",
            "additionalProperties": false,
            "required": ["timeout_seconds", "heartbeat_seconds"],
            "properties": {
              "timeout_seconds": {"type": "integer", "minimum": 30},
              "heartbeat_seconds": {"type": "integer", "minimum": 1}
            }
          },
          "retry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["max_attempts"],
            "properties": {
              "max_attempts": {"type": "integer", "minimum": 1},
              "backoff_seconds": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    }
  }
}
