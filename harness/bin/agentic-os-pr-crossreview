#!/usr/bin/env python3
"""Run a senior-engineer PR review using the harness OPPOSITE to the PR's author.

Given a GitHub PR, detects whether the PR was authored by Claude Code or Codex,
then routes the review to the other harness. This enforces independent review:
a Codex-written PR is reviewed by Claude; a Claude-written PR is reviewed by Codex.

Detection order (configured in harness-routing.yml → pr_crossreview.author_detection):
  1. commit_trailer — scan PR commits for "Co-Authored-By:.*Claude" trailer
  2. branch_prefix  — match branch name against branch_prefix_map
  3. default_author — fall back to configured default (typically gpt)

The review prompt instructs the reviewer to act as a blocker-focused senior engineer.
Content scrub runs before any --post action: if the review references internal
paths, tool names, or personal workspace details, the post is blocked.
"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import textwrap
import time
import uuid
from pathlib import Path

# This executable is invoked directly by scheduled jobs as well as from an
# editable install. Make the source package available before importing the
# shared bridge so ``python3 harness/bin/agentic-os-pr-crossreview`` remains a
# supported entrypoint outside a virtualenv.
_REPO_ROOT = Path(__file__).resolve().parents[2]
_SRC_DIR = _REPO_ROOT / "src"
if str(_SRC_DIR) not in sys.path:
    sys.path.insert(0, str(_SRC_DIR))

try:
    import yaml
except ImportError:  # pragma: no cover
    print("error: PyYAML is required (pip install pyyaml)", file=sys.stderr)
    sys.exit(2)

from genomes_agentic_os.github_bridge import (
    GitHubBridgeError,
    command_from_environment as github_command_from_environment,
    get_pull_request as bridge_get_pull_request,
    get_pull_request_diff as bridge_get_pull_request_diff,
    list_pull_request_commits as bridge_list_pull_request_commits,
)
from genomes_agentic_os.review_coordination import (
    ReviewBudgetExceeded,
    ReviewCoordinationError,
    ReviewCoordinator,
    ReviewSubject,
    canonical_review_purpose,
    load_review_receipt,
    provider_review_marker,
    review_chain_key,
    shared_review_coordination_root,
    stable_review_key,
)

# ── Constants ─────────────────────────────────────────────────────────────────

INSTANCE_ROOT = Path.home() / "agentic_os"

_BIN_DIR = Path(__file__).resolve().parent
ROUTING_CONFIG = _BIN_DIR.parent / "registries" / "harness-routing.yml"
HARNESS_RUN_BIN = _BIN_DIR / "agentic-harness-run"

# Maximum diff size to pass directly in the prompt (chars).
MAX_DIFF_CHARS = 40_000
# The bridge pages commit reads up to this explicit cap. Hitting the cap is
# ambiguous (the PR might have more commits), so author detection fails closed
# instead of silently selecting the wrong reviewer.
MAX_COMMIT_SCAN = 1_000
DEFAULT_REVIEW_SCOPE = "full-pr"
BUDGET_BLOCK_EXIT_CODE = 3
PURPOSE_ALIASES = {
    "finalize",
    "merge-readiness",
    "review-others",
    "review-repair",
    "review-self",
    "review_others",
    "review_repair",
    "review_self",
}
SCOPE_ALIASES = {
    "full-pr": DEFAULT_REVIEW_SCOPE,
    "full_pr": DEFAULT_REVIEW_SCOPE,
    "pr": DEFAULT_REVIEW_SCOPE,
}
VERDICT_PATTERN = re.compile(
    r"^AGENTIC_OS_REVIEW_VERDICT:\s*(CLEAN|FINDINGS)\s*$",
    re.IGNORECASE | re.MULTILINE,
)

# Patterns that will fail the scrub gate (regex, applied to review text).
# This list protects team-visible PR comments from leaking internal details.
SCRUB_PATTERNS = [
    r"/Users/genome",
    r"\bagentic_os\b",
    r"notion\.so",
    r"\bharness/\b",
    r"\bSKILL\b",
    r"skill name",
    r"/Users/",
    r"~/\.claude",
    r"~/\.codex",
    r"\.claude/",
    r"\.codex/",
]

# ── Helpers ───────────────────────────────────────────────────────────────────


def now_iso() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def load_routing() -> dict:
    try:
        with ROUTING_CONFIG.open(encoding="utf-8") as fh:
            return yaml.safe_load(fh) or {}
    except FileNotFoundError:
        return {}
    except Exception as exc:  # noqa: BLE001
        print(f"warning: could not load routing config: {exc}", file=sys.stderr)
        return {}


def parse_pr_ref(pr_ref: str, repo: str | None) -> tuple[str, int]:
    """Return (repo, pr_number) from a PR URL or bare number.

    Accepts:
      - "123"  (requires --repo)
      - "https://github.com/owner/name/pull/123"
      - "owner/name#123"
    """
    url_match = re.match(r"https://github\.com/([^/]+/[^/]+)/pull/(\d+)", pr_ref)
    if url_match:
        return url_match.group(1), int(url_match.group(2))

    hash_match = re.match(r"([^#]+)#(\d+)$", pr_ref)
    if hash_match:
        parsed_repo = hash_match.group(1)
        if "/" not in parsed_repo:
            print("error: repository must be in owner/name format.", file=sys.stderr)
            sys.exit(1)
        return parsed_repo, int(hash_match.group(2))

    if pr_ref.isdigit():
        if not repo:
            print("error: --repo owner/name is required when --pr is a bare number.", file=sys.stderr)
            sys.exit(1)
        if "/" not in repo:
            print("error: --repo must be in owner/name format.", file=sys.stderr)
            sys.exit(1)
        return repo, int(pr_ref)

    print(f"error: cannot parse PR reference '{pr_ref}'. Use a number (with --repo), URL, or owner/name#N.", file=sys.stderr)
    sys.exit(1)


def gh(*args: str, check: bool = True) -> str:
    """Run the legacy gh CLI write path and return stdout."""
    result = subprocess.run(
        ["gh", *args],
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
        timeout=60,
    )
    if check and result.returncode != 0:
        print(f"error: gh {' '.join(args)} failed:\n{result.stderr}", file=sys.stderr)
        sys.exit(1)
    return result.stdout.strip()


def _sha256(value: object) -> str:
    payload = json.dumps(value, sort_keys=True, separators=(",", ":")).encode("utf-8")
    return hashlib.sha256(payload).hexdigest()


def normalize_review_purpose(purpose: str, scope: str) -> tuple[str, str]:
    """Collapse stage aliases onto one bounded review family and scope.

    The cross-review command only serves merge-readiness review. Accepting free-form
    purpose or scope values would create fresh family keys and bypass the circuit
    breakers, so aliases are closed and normalized before key construction.
    """
    requested_purpose = str(purpose).strip().lower()
    normalized_scope = SCOPE_ALIASES.get(str(scope).strip().lower())
    if requested_purpose not in PURPOSE_ALIASES:
        raise ReviewCoordinationError(
            "cross-review purpose must be one of the documented merge-readiness stage aliases"
        )
    if normalized_scope is None:
        raise ReviewCoordinationError("cross-review scope must resolve to full-pr")
    return canonical_review_purpose(requested_purpose), normalized_scope


def get_base_sha(repo: str, pr: int, meta: dict, override: str | None = None) -> str:
    """Resolve the provider-read exact base SHA used by the stable review key."""
    candidate = override or meta.get("base_sha")
    if not candidate:
        candidate = gh("api", f"repos/{repo}/pulls/{pr}", "--jq", ".base.sha")
    candidate = str(candidate).strip()
    if not re.fullmatch(r"[0-9a-fA-F]{7,64}", candidate):
        raise ReviewCoordinationError("provider base SHA is unavailable or invalid")
    return candidate


def list_provider_comments(repo: str, pr: int) -> list[dict]:
    """Read provider issue comments for terminal marker reuse."""
    raw = gh("api", f"repos/{repo}/issues/{pr}/comments", "--paginate")
    try:
        value = json.loads(raw or "[]")
    except json.JSONDecodeError as exc:
        raise ReviewCoordinationError("provider comment readback was not valid JSON") from exc
    if not isinstance(value, list):
        raise ReviewCoordinationError("provider comment readback was not a list")
    return [dict(row) for row in value if isinstance(row, dict)]


def existing_provider_marker(repo: str, pr: int, marker: str) -> dict | None:
    """Return the existing provider comment carrying the stable review marker."""
    for row in list_provider_comments(repo, pr):
        if any(line.strip() == marker for line in str(row.get("body") or "").splitlines()):
            return row
    return None


def get_revision_diff(repo: str, base_sha: str, head_sha: str) -> str:
    """Read one descendant delta between two provider revisions.

    ``build_review_prompt`` applies the hard prompt-size bound. Keeping the
    complete delta here preserves its original length and truncation evidence
    without blocking a legitimate repair range before the reviewer is called.
    """
    if base_sha == head_sha:
        raise ReviewCoordinationError("delta review requires a changed head revision")
    compare_ref = f"repos/{repo}/compare/{base_sha}...{head_sha}"
    status = gh("api", compare_ref, "--jq", ".status").strip().lower()
    if status != "ahead":
        raise ReviewCoordinationError(
            "delta parent must be an ancestor of the current provider head"
        )
    delta = gh(
        "api",
        compare_ref,
        "--header",
        "Accept: application/vnd.github.v3.diff",
    )
    return delta


def post_terminal_review(
    repo: str,
    pr: int,
    expected_head: str,
    marker: str,
    receipt: dict,
    *,
    post_mode: str,
) -> dict:
    """Post one terminal review after head reread, or reuse provider readback."""
    verified = get_pr_meta(repo, pr)
    if verified["head_sha"] != expected_head:
        raise ReviewCoordinationError(
            "pull request head changed after review; terminal provider post blocked"
        )
    existing = existing_provider_marker(repo, pr, marker)
    if existing is not None:
        return {
            "action": "reused",
            "comment_id": existing.get("id"),
            "url": existing.get("html_url") or existing.get("url"),
            "head_sha": expected_head,
            "readback_verified": True,
        }
    review = receipt.get("review") or {}
    if receipt.get("status") != "completed" or receipt.get("outcome") != "clean":
        raise ReviewCoordinationError("only a completed clean terminal review may be posted")
    body = str(review.get("text") or "").strip()
    if not body:
        raise ReviewCoordinationError("terminal review has no provider-safe body")
    if review.get("scrub_passed") is not True:
        raise ReviewCoordinationError("terminal review failed the provider content scrub")
    consolidated = f"{body}\n\n{marker}"
    if post_mode == "comment":
        gh("pr", "comment", str(pr), "--repo", repo, "--body", consolidated)
    elif post_mode == "draft":
        gh("pr", "review", str(pr), "--repo", repo, "--comment", "--body", consolidated)
    else:
        raise ReviewCoordinationError(f"unsupported provider post mode: {post_mode}")
    readback = existing_provider_marker(repo, pr, marker)
    if readback is None:
        raise ReviewCoordinationError("provider post marker was not visible on readback")
    return {
        "action": "posted",
        "comment_id": readback.get("id"),
        "url": readback.get("html_url") or readback.get("url"),
        "head_sha": expected_head,
        "readback_verified": True,
    }


def parse_review_verdict(review_text: str) -> tuple[str, bool]:
    """Parse only the final non-empty line so prompt echo cannot forge a verdict."""
    lines = [line.strip() for line in review_text.splitlines() if line.strip()]
    if not lines:
        return "findings", False
    match = VERDICT_PATTERN.fullmatch(lines[-1])
    if match is None:
        return "findings", False
    if match.group(1).upper() == "CLEAN":
        return "clean", True
    if match.group(1).upper() == "FINDINGS":
        return "findings", True
    return "findings", False


def classify_review_outcome(exit_code: int, review_text: str, scrub_passed: bool) -> str:
    """Keep findings canonical; make an unpublishable clean output retryable."""
    if exit_code != 0 or not review_text.strip():
        return "unavailable"
    parsed, _structured = parse_review_verdict(review_text)
    if parsed == "clean" and not scrub_passed:
        return "unavailable"
    return parsed


def get_pr_meta(repo: str, pr: int) -> dict:
    """Fetch PR metadata through the versioned shared GitHub read port."""
    data = _bridge_pull_request(repo, pr)
    head_sha = data.get("headSha")
    if not isinstance(head_sha, str) or not head_sha:
        print("error: GitHub bridge PR read returned no head SHA.", file=sys.stderr)
        sys.exit(1)
    return {
        "title": data.get("title", ""),
        "body": data.get("body", "") or "",
        "head_branch": data.get("headBranch", ""),
        "head_sha": head_sha,
        "base_branch": data.get("baseBranch", ""),
        "base_sha": data.get("baseSha", ""),
        "author_login": data.get("author", ""),
    }


def get_pr_commits(repo: str, pr: int) -> list[dict]:
    """Return a bounded commit scan, failing closed if it might be truncated."""
    command, token = _bridge_credentials()
    owner, repo_name = repo.split("/", 1)
    try:
        commits = bridge_list_pull_request_commits(
            command, owner=owner, repo=repo_name, number=pr, token=token, limit=MAX_COMMIT_SCAN
        )
    except GitHubBridgeError as exc:
        print(f"error: GitHub bridge commit read failed ({exc.code})", file=sys.stderr)
        sys.exit(1)
    if len(commits) >= MAX_COMMIT_SCAN:
        print(
            "error: PR commit scan reached its safe bound; cannot select an independent reviewer reliably.",
            file=sys.stderr,
        )
        sys.exit(1)
    return [{"sha": commit["sha"], "commit": {"message": commit["message"]}} for commit in commits]


def get_pr_diff(repo: str, pr: int) -> str:
    """Return the PR diff text (may be large) through the shared read port."""
    try:
        command, token = _bridge_credentials()
        owner, repo_name = repo.split("/", 1)
        return bridge_get_pull_request_diff(
            command, owner=owner, repo=repo_name, number=pr, token=token
        )
    except GitHubBridgeError as exc:
        print(f"warning: GitHub bridge diff unavailable ({exc.code})", file=sys.stderr)
        return "(diff unavailable)"


def _bridge_credentials() -> tuple[list[str], str]:
    """Resolve the explicit shared-read transport without accepting a shell command."""
    command = github_command_from_environment()
    token = os.environ.get("GITHUB_TOKEN", "").strip()
    if command is None:
        print("error: GENOMES_GITHUB_BRIDGE_COMMAND must be configured for cross-review reads.", file=sys.stderr)
        sys.exit(1)
    if not token:
        print("error: GITHUB_TOKEN must be configured for cross-review reads.", file=sys.stderr)
        sys.exit(1)
    return command, token


def _bridge_pull_request(repo: str, pr: int) -> dict:
    command, token = _bridge_credentials()
    owner, repo_name = repo.split("/", 1)
    try:
        pull_request = bridge_get_pull_request(
            command, owner=owner, repo=repo_name, number=pr, token=token
        )
    except GitHubBridgeError as exc:
        print(f"error: GitHub bridge PR read failed ({exc.code})", file=sys.stderr)
        sys.exit(1)
    if pull_request is None:
        print(f"error: pull request #{pr} was not found in {repo}.", file=sys.stderr)
        sys.exit(1)
    return pull_request


def detect_author_harness(meta: dict, commits: list[dict], routing: dict) -> str:
    """Detect which harness authored the PR.

    Returns 'claude' or 'gpt'.
    Detection order comes from routing config pr_crossreview.author_detection.
    """
    pr_config = routing.get("pr_crossreview") or {}
    detection_order = pr_config.get("author_detection") or [
        "commit_trailer",
        "branch_prefix",
        {"default_author": "gpt"},
    ]
    branch_prefix_map = pr_config.get("branch_prefix_map") or {
        "claude": ["claude/"],
        "gpt": ["codex/", "gpt/", "feature/codex-"],
    }

    head_branch = meta["head_branch"]

    for step in detection_order:
        if step == "commit_trailer" or (isinstance(step, dict) and "commit_trailer" in step):
            for commit in commits:
                message = commit.get("commit", {}).get("message", "")
                # Match "Co-Authored-By:.*Claude" case-insensitively.
                if re.search(r"Co-Authored-By:.*Claude", message, re.IGNORECASE):
                    return "claude"
            # No claude trailer found; continue to next step.

        elif step == "branch_prefix" or (isinstance(step, dict) and "branch_prefix" in step):
            for harness_name, prefixes in branch_prefix_map.items():
                for prefix in prefixes:
                    if head_branch.startswith(prefix):
                        return harness_name
            # No branch prefix matched; continue.

        elif isinstance(step, dict) and "default_author" in step:
            default = step["default_author"]
            if default in ("claude", "gpt"):
                return default

        elif step == "default_author":
            # Plain string form — use config default or fall back to gpt.
            return pr_config.get("default_author", "gpt")

    return "gpt"


def read_consistent_pr_inputs(
    repo: str, pr: int, *, include_commits: bool
) -> tuple[dict, list[dict], str] | None:
    """Read review inputs and prove they all describe one non-empty PR head."""
    initial_meta = get_pr_meta(repo, pr)
    commits = get_pr_commits(repo, pr) if include_commits else []
    diff = get_pr_diff(repo, pr)
    verified_meta = get_pr_meta(repo, pr)
    if initial_meta["head_sha"] != verified_meta["head_sha"]:
        print(
            "error: pull request head changed while cross-review inputs were being read; retry on the new head.",
            file=sys.stderr,
        )
        return None
    return verified_meta, commits, diff


def opposite_harness(harness: str) -> str:
    return "gpt" if harness == "claude" else "claude"


def build_review_prompt(repo: str, pr: int, meta: dict, diff: str) -> str:
    """Build the review prompt handed to the reviewing harness."""
    diff_section = diff
    truncated = False
    if len(diff) > MAX_DIFF_CHARS:
        diff_section = diff[:MAX_DIFF_CHARS]
        truncated = True

    truncation_note = (
        f"\n\n[DIFF TRUNCATED: original was {len(diff):,} chars; showing first {MAX_DIFF_CHARS:,}]"
        if truncated
        else ""
    )

    return textwrap.dedent(f"""\
        You are a senior engineer doing a blocking PR review. Your job is to find
        real problems that should block merging: logic errors, security issues,
        missing error handling, broken contracts, incorrect assumptions, and
        dangerous migrations. Do NOT raise style nits or formatting preferences.

        Review the following pull request and output GitHub-ready markdown comment(s).
        Each finding should state: severity (BLOCKER | WARNING | FYI), the file and
        line range (if known), a concise description of the problem, and a concrete
        suggestion for fixing it.

        IMPORTANT: Your output will be posted as a public PR comment visible to the
        whole engineering team. Do NOT mention local filesystem paths, internal tool
        names, personal workspace names, or anything that only applies to a specific
        developer's machine. Write as a peer reviewer, not as an automated tool.

        ── PR DETAILS ────────────────────────────────────────────────────────────────
        Repository: {repo}
        PR #{pr}: {meta['title']}

        Description:
        {meta['body'] or '(no description provided)'}

        ── DIFF ──────────────────────────────────────────────────────────────────────
        {diff_section}{truncation_note}

        ── END DIFF ──────────────────────────────────────────────────────────────────

        Provide your review findings in GitHub-flavored markdown. Start with a one-line
        summary of your overall assessment, then list findings as separate sections.
        If you find no blockers, say so explicitly. End with exactly one of these
        machine-readable lines (do not put it in a code block):

        AGENTIC_OS_REVIEW_VERDICT: CLEAN
        AGENTIC_OS_REVIEW_VERDICT: FINDINGS

        Use CLEAN only when there are no BLOCKER or WARNING findings. Missing,
        contradictory, or malformed verdict output will fail closed as findings.
    """)


def scrub_check(text: str) -> list[str]:
    """Return list of matched patterns; empty list means the text passed scrub."""
    hits = []
    for pattern in SCRUB_PATTERNS:
        if re.search(pattern, text, re.IGNORECASE):
            hits.append(pattern)
    return hits


def run_harness_review(
    reviewer_harness: str,
    prompt: str,
    model: str | None,
    timeout_sec: int,
    output_file: Path,
) -> tuple[int, str]:
    """Invoke agentic-harness-run and return (exit_code, review_text).

    The reviewer subprocess runs in a neutral temp directory (not agentic_os)
    to reduce the risk of the harness ingesting internal context files (CLAUDE.md,
    AGENTS.md, agentic_os-specific rules) that could leak into the review output.
    """
    with tempfile.NamedTemporaryFile(mode="w", suffix=".txt", delete=False, encoding="utf-8") as tf:
        tf.write(prompt)
        prompt_file = tf.name

    # Use a neutral temp cwd so the reviewer doesn't pick up internal CLAUDE.md / AGENTS.md.
    review_cwd = tempfile.mkdtemp(prefix="crossreview-cwd-")

    try:
        cmd = [
            sys.executable, str(HARNESS_RUN_BIN),
            "--harness", reviewer_harness,
            "--prompt-file", prompt_file,
            "--output", str(output_file),
            "--timeout-sec", str(timeout_sec),
            "--task-type", "review",
            "--cwd", review_cwd,
        ]
        if model:
            cmd += ["--model", model]

        result = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            timeout=timeout_sec + 30,
        )
        # Read the artifact (output file contains stdout + stderr).
        if output_file.exists():
            artifact = output_file.read_text(encoding="utf-8")
            # Extract just stdout portion.
            if "=== stdout ===" in artifact:
                review_text = artifact.split("=== stdout ===", 1)[1]
                if "=== stderr ===" in review_text:
                    review_text = review_text.split("=== stderr ===", 1)[0]
            else:
                review_text = artifact
        else:
            review_text = result.stdout

        return result.returncode, review_text.strip()
    finally:
        Path(prompt_file).unlink(missing_ok=True)
        # Clean up the neutral cwd temp dir.
        import shutil
        shutil.rmtree(review_cwd, ignore_errors=True)


# ── CLI ───────────────────────────────────────────────────────────────────────

_EPILOG = textwrap.dedent("""\
    ENVIRONMENT
      AGENTIC_HARNESS_FORCE   Override the reviewer harness selection. Values: claude | gpt.
                              Bypasses the author-detection logic entirely.
      ANTHROPIC_API_KEY       Stripped automatically when the claude harness is used.

    CONFIG FILES (read at runtime)
      harness/registries/harness-routing.yml
          pr_crossreview section: author_detection order, branch_prefix_map,
          default_author, post_mode, scrub rules.

    ARTIFACT FILES (written after every run)
      <agentic-os-root>/harness/shared_factory/06-runs-and-logs/harness-runs/crossreview-artifacts/<review-key>.txt
          The full review output (stdout+stderr from the reviewing harness).
      <agentic-os-root>/harness/shared_factory/06-runs-and-logs/harness-runs/crossreview-artifacts/<review-key>.meta.json
          Receipt: PR, repo, author_harness, reviewer_harness, scrub_passed, artifact path.
      <agentic-os-root>/state/review-coordination/
          The single shared coordination root for receipts, locks, budgets, and
          provider-post deduplication. --output-dir never changes this root.

    EXAMPLES
      agentic-os-pr-crossreview --repo owner/repo --pr 123
          Detect author harness, pick opposite, run review, print to stdout. No GitHub post.

      agentic-os-pr-crossreview --pr https://github.com/owner/repo/pull/42
          Resolve PR from URL; no --repo needed.

      agentic-os-pr-crossreview --repo owner/repo --pr 42 --post
          Run review and post as a PR comment (post_mode from harness-routing.yml).

      agentic-os-pr-crossreview --repo owner/repo --pr 42 --reviewer claude
          Force the reviewer to claude regardless of author detection.
""")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="agentic-os-pr-crossreview",
        description=(
            "Run a senior-engineer PR review using the harness OPPOSITE to the PR's author. "
            "Detects authoring harness via commit trailers and branch name, then routes to the other."
        ),
        epilog=_EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--repo",
        metavar="OWNER/NAME",
        help="GitHub repository in owner/name format. Required when --pr is a bare number.",
    )
    parser.add_argument(
        "--pr",
        required=True,
        metavar="N|URL",
        help="PR number, full GitHub URL, or owner/name#N reference. Required.",
    )
    parser.add_argument(
        "--reviewer",
        choices=["claude", "gpt"],
        help="Force a specific reviewer harness, bypassing author detection.",
    )
    parser.add_argument(
        "--model",
        metavar="NAME",
        help="Model override passed to the reviewing harness.",
    )
    parser.add_argument(
        "--timeout-sec",
        type=int,
        default=DEFAULT_TIMEOUT_SEC if "DEFAULT_TIMEOUT_SEC" in dir() else 900,
        metavar="N",
        help="Kill the reviewer harness after N seconds (default: %(default)s).",
    )
    parser.add_argument(
        "--post",
        action="store_true",
        help=(
            "Post the review to GitHub after passing the scrub gate. "
            "Post mode (draft/comment) is read from harness-routing.yml → pr_crossreview.post_mode. "
            "Live mode requires GitHub write access and calls 'gh pr comment' or 'gh pr review'."
        ),
    )
    parser.add_argument(
        "--base-sha",
        metavar="SHA",
        help="Exact provider base SHA. When omitted it is read from GitHub.",
    )
    parser.add_argument(
        "--policy-fingerprint",
        metavar="SHA256",
        help="Frozen review-policy SHA-256. Defaults to the effective cross-review config hash.",
    )
    parser.add_argument(
        "--purpose",
        default="review_self",
        help=(
            "Merge-readiness stage alias. Known review/finalize aliases normalize "
            "to one bounded family (default: %(default)s)."
        ),
    )
    parser.add_argument(
        "--scope",
        default=DEFAULT_REVIEW_SCOPE,
        help="Review scope included in the stable purpose (default: %(default)s).",
    )
    parser.add_argument(
        "--mode",
        choices=["full", "delta"],
        default="full",
        help="Review mode. Repair may request delta with --parent-key.",
    )
    parser.add_argument(
        "--parent-key",
        help="Canonical parent receipt key required for delta review.",
    )
    parser.add_argument(
        "--output-dir",
        metavar="DIR",
        help=(
            "Directory for reviewer artifacts and the compatibility receipt "
            "(default: <agentic-os-root>/harness/shared_factory/06-runs-and-logs/harness-runs)."
        ),
    )
    parser.add_argument(
        "--os-root",
        type=Path,
        default=Path(os.environ.get("AGENTIC_OS_ROOT", str(INSTANCE_ROOT))),
        metavar="DIR",
        help=(
            "Installed Agentic OS root used to resolve the shared coordination "
            "store (default: AGENTIC_OS_ROOT or the installed instance root)."
        ),
    )
    return parser


def write_legacy_receipt(
    path: Path,
    *,
    review_result: object,
    post_result: object | None,
    repo: str,
    pr_number: int,
    meta: dict,
    base_sha: str,
    review_mode: str,
) -> dict:
    """Write the compatibility receipt without replacing the review result."""
    review_receipt = getattr(review_result, "receipt")
    post_receipt = getattr(post_result, "receipt") if post_result is not None else review_receipt
    review = dict(review_receipt.get("review") or {})
    payload = {
        "ts": now_iso(),
        "repo": repo,
        "pr": pr_number,
        "pr_title": meta["title"],
        "head_sha": meta["head_sha"],
        "base_sha": base_sha,
        "review_key": getattr(review_result, "key"),
        "review_mode": review_mode,
        "reused": bool(getattr(review_result, "reused")),
        "coordination_receipt": str(getattr(review_result, "receipt_path")),
        "provider_marker": provider_review_marker(getattr(review_result, "key")),
        "provider_post": post_receipt.get("provider_post"),
        **review,
    }
    path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return payload


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    routing = load_routing()
    pr_config = routing.get("pr_crossreview") or {}

    # Parse PR reference.
    repo, pr_number = parse_pr_ref(args.pr, args.repo)

    # Determine artifact directory.
    artifact_dir = (
        Path(args.output_dir).expanduser().resolve()
        if args.output_dir
        else args.os_root.expanduser().resolve()
        / "harness/shared_factory/06-runs-and-logs/harness-runs"
    )
    artifact_dir.mkdir(parents=True, exist_ok=True)

    print(f"[crossreview] Fetching PR #{pr_number} from {repo} ...", file=sys.stderr)

    # Read all review inputs first. When author detection is automatic, commit
    # and branch evidence is inside the same exact-head window as the diff.
    forced = os.environ.get("AGENTIC_HARNESS_FORCE", "").strip().lower()
    needs_author_detection = not args.reviewer and forced not in ("claude", "gpt")
    inputs = read_consistent_pr_inputs(repo, pr_number, include_commits=needs_author_detection)
    if inputs is None:
        return 1
    meta, commits, diff = inputs

    try:
        base_sha = get_base_sha(repo, pr_number, meta, args.base_sha)
        policy_fingerprint = args.policy_fingerprint or _sha256(pr_config)
        purpose, _scope = normalize_review_purpose(args.purpose, args.scope)
        subject = ReviewSubject(
            repository=repo,
            pull_request=f"github:{repo}#{pr_number}",
            base_branch=str(meta.get("base_branch") or "unknown-base"),
            base_sha=base_sha,
            head_sha=str(meta["head_sha"]),
            policy_fingerprint=policy_fingerprint,
            purpose=purpose,
        )
    except ReviewCoordinationError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1

    coordinator = ReviewCoordinator(shared_review_coordination_root(args.os_root))
    review_key = stable_review_key(subject)
    artifact_stem = artifact_dir / "crossreview-artifacts" / review_key
    artifact_stem.parent.mkdir(parents=True, exist_ok=True)
    output_file = Path(str(artifact_stem) + ".txt")
    meta_file = Path(str(artifact_stem) + ".meta.json")

    if args.mode == "delta":
        if not args.parent_key:
            print("error: --parent-key is required for delta review", file=sys.stderr)
            return 1
        try:
            parent = load_review_receipt(coordinator.receipts / f"{args.parent_key}.json")
            parent_subject = ReviewSubject.from_mapping(parent["subject"])
            if review_chain_key(parent_subject) != review_chain_key(subject):
                raise ReviewCoordinationError(
                    "delta parent must belong to the same repository, PR, base, policy, and purpose"
                )
            parent_head = str(parent["subject"]["head_sha"])
            diff = get_revision_diff(repo, parent_head, subject.head_sha)
        except (KeyError, ReviewCoordinationError) as exc:
            print(f"error: delta parent is invalid ({exc})", file=sys.stderr)
            return 1

    # Detect author harness.
    if args.reviewer:
        reviewer_harness = args.reviewer
        author_harness = opposite_harness(reviewer_harness)
        author_detected_by = "forced-reviewer-flag"
    else:
        if forced in ("claude", "gpt"):
            reviewer_harness = forced
            author_harness = opposite_harness(reviewer_harness)
            author_detected_by = "AGENTIC_HARNESS_FORCE"
        else:
            print("[crossreview] Detecting author harness from PR commits and branch ...", file=sys.stderr)
            author_harness = detect_author_harness(meta, commits, routing)
            reviewer_harness = opposite_harness(author_harness)
            author_detected_by = "auto"

    print(f"[crossreview] Author harness: {author_harness} (detected by: {author_detected_by})", file=sys.stderr)
    print(f"[crossreview] Reviewer harness: {reviewer_harness}", file=sys.stderr)

    print(f"[crossreview] Diff size: {len(diff):,} chars", file=sys.stderr)
    if len(diff) > MAX_DIFF_CHARS:
        print(f"[crossreview] Diff truncated to {MAX_DIFF_CHARS:,} chars in prompt.", file=sys.stderr)

    # Build review prompt.
    prompt = build_review_prompt(repo, pr_number, meta, diff)

    timeout_sec = getattr(args, "timeout_sec", 900)

    def execute_review() -> dict:
        print(
            f"[crossreview] Running {reviewer_harness} {args.mode} review "
            f"(timeout: {timeout_sec}s) ...",
            file=sys.stderr,
        )
        started = time.monotonic()
        exit_code, review_text = run_harness_review(
            reviewer_harness=reviewer_harness,
            prompt=prompt,
            model=args.model,
            timeout_sec=timeout_sec,
            output_file=output_file,
        )
        duration = round(time.monotonic() - started, 2)
        scrub_hits = scrub_check(review_text)
        scrub_passed = not scrub_hits
        parsed_outcome, verdict_structured = parse_review_verdict(review_text)
        outcome = classify_review_outcome(exit_code, review_text, scrub_passed)
        return {
            "outcome": outcome,
            "text": review_text,
            "exit_code": exit_code,
            "duration_sec": duration,
            "scrub_passed": scrub_passed,
            "scrub_hits": scrub_hits,
            "parsed_outcome": parsed_outcome,
            "verdict_structured": verdict_structured,
            "availability_failure": (
                "provider_scrub_failed"
                if outcome == "unavailable"
                and parsed_outcome == "clean"
                and not scrub_passed
                else None
            ),
            "provider_post_eligibility": (
                "eligible"
                if outcome == "clean" and scrub_passed
                else "blocked_scrub"
                if not scrub_passed
                else "not_clean"
            ),
            "artifact_file": str(output_file),
            "author_harness": author_harness,
            "author_detected_by": author_detected_by,
            "reviewer_harness": reviewer_harness,
            "model": args.model or "(default)",
        }

    provider_post_call = None
    if args.post:
        post_mode = str(pr_config.get("post_mode", "comment"))

        def provider_post_call(marker: str, receipt: dict) -> dict:
            return post_terminal_review(
                repo,
                pr_number,
                subject.head_sha,
                marker,
                receipt,
                post_mode=post_mode,
            )

    try:
        review_result = coordinator.execute(
            subject,
            execute_review,
            mode=args.mode,
            parent_key=args.parent_key,
        )
        review_for_post = dict(review_result.receipt.get("review") or {})
        post_result = None
        if (
            provider_post_call is not None
            and review_result.receipt.get("outcome") == "clean"
            and review_for_post.get("scrub_passed") is True
        ):
            post_result = coordinator.post_terminal(
                subject,
                provider_post_call,
                scrub_passed=True,
            )
    except ReviewBudgetExceeded as exc:
        print(f"budget-block: {exc}", file=sys.stderr)
        return BUDGET_BLOCK_EXIT_CODE
    except ReviewCoordinationError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1

    review = dict(review_result.receipt.get("review") or {})
    write_legacy_receipt(
        meta_file,
        review_result=review_result,
        post_result=post_result,
        repo=repo,
        pr_number=pr_number,
        meta=meta,
        base_sha=base_sha,
        review_mode=args.mode,
    )
    print(
        f"[crossreview] {'Reused' if review_result.reused else 'Created'} review receipt: "
        f"{review_result.receipt_path}",
        file=sys.stderr,
    )
    print(str(review.get("text") or ""))
    return 0 if review_result.receipt.get("outcome") in {"clean", "findings"} else 1


# Expose DEFAULT_TIMEOUT_SEC in module scope for argparse default.
DEFAULT_TIMEOUT_SEC = 900

if __name__ == "__main__":
    sys.exit(main())
