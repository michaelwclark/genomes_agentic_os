#!/bin/sh
set -eu

ROOT="${AGENTIC_OS_ROOT:-$HOME/agentic_os}"
SELF_NAME=${0##*/}
OBJECT_ID=$(printf '%s\n' "${SELF_NAME#agentic-os-}" | tr '-' '_')
DOMAIN=${OBJECT_ID%%_*}
PROGRAM=${OBJECT_ID#*_}
CONTROLLER="$ROOT/lib/programs/domains/$DOMAIN/$OBJECT_ID/scripts/$PROGRAM.py"

if [ ! -f "$CONTROLLER" ]; then
  printf 'FullSail updater controller not found in the installed library.\n' >&2
  exit 1
fi

PYTHON="${AGENTIC_OS_PYTHON:-}"
if [ -z "$PYTHON" ] || [ ! -x "$PYTHON" ]; then
  PYTHON=""
  for candidate in \
    "$HOME/Library/Application Support/AgenticOS/development-delivery-runtime/bin/python" \
    "$HOME/Library/Application Support/AgenticOS/layout-v2-runtime/bin/python" \
    "$HOME/Library/Application Support/AgenticOS/agentic-os-source/bin/python"
  do
    if [ -x "$candidate" ] && "$candidate" -c 'import genomes_agentic_os' >/dev/null 2>&1; then
      PYTHON="$candidate"
      break
    fi
  done
fi
if [ -z "$PYTHON" ]; then
  RELEASES="$HOME/Library/Application Support/AgenticOS/releases"
  if [ -d "$RELEASES" ]; then
    OLD_IFS=$IFS
    IFS='
'
    for candidate in $(ls -1dt "$RELEASES"/*/runtime/bin/python 2>/dev/null || true)
    do
      if [ -x "$candidate" ] && "$candidate" -c 'import genomes_agentic_os' >/dev/null 2>&1; then
        PYTHON="$candidate"
        break
      fi
    done
    IFS=$OLD_IFS
  fi
fi
if [ -z "$PYTHON" ]; then
  candidate=$(command -v python3 || true)
  if [ -n "$candidate" ] && [ -x "$candidate" ] && "$candidate" -c 'import genomes_agentic_os' >/dev/null 2>&1; then
    PYTHON="$candidate"
  fi
fi
if [ -z "$PYTHON" ] || [ ! -x "$PYTHON" ]; then
  printf 'Agentic OS Python runtime not found.\n' >&2
  exit 1
fi

exec "$PYTHON" "$CONTROLLER" --root "$ROOT" "$@"
