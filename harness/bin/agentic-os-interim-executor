#!/usr/bin/env python3
"""Compatibility entry point that delegates all automation work to the runtime supervisor.

Older LaunchAgents still call this path. It intentionally performs no schedule
selection or command execution of its own, so every automation passes through
the selected queue backend and its admission controls.
"""

from __future__ import annotations

import argparse
import os
from pathlib import Path
import shutil
import subprocess


SCRIPT_NAME = "agentic-os-interim-executor"
DEFAULT_ROOT = Path(os.environ.get("AGENTIC_OS_ROOT", "/Users/genome/agentic_os"))
DEFAULT_CLI = Path(
    os.environ.get(
        "AGENTIC_OS_CLI",
        shutil.which("agentic-os") or Path.home() / ".local/bin/agentic-os",
    )
)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog=SCRIPT_NAME,
        description="Compatibility shim: run one canonical Agentic OS supervisor tick.",
    )
    parser.add_argument("--once", action="store_true", default=True, help="Compatibility flag; one tick is always run.")
    parser.add_argument("--dry-run", action="store_true", help="Plan the supervisor tick without queue or dispatch writes.")
    parser.add_argument("--only", metavar="ID", help="Deprecated compatibility flag; direct schedule execution is disabled.")
    parser.add_argument("--root", type=Path, default=DEFAULT_ROOT, help="Installed Agentic OS root.")
    args = parser.parse_args(argv)

    if args.only:
        parser.error("--only is no longer supported; use `agentic-os schedule queue-now ID --apply` so work enters the managed queue")
    command = [str(DEFAULT_CLI), "runtime", "supervise", "--root", str(args.root)]
    command.append("--dry-run" if args.dry_run else "--apply")
    completed = subprocess.run(command, cwd=args.root, check=False)
    return completed.returncode


if __name__ == "__main__":
    raise SystemExit(main())
