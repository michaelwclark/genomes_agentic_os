#!/usr/bin/env python3
"""Replace one automation's Notion last-run summary page."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any

import yaml


ROOT = Path(__file__).resolve().parents[2]
DEFAULT_MANIFEST = ROOT / "harness/shared_factory/00-control-plane/automation-run-tracking.yml"
DEFAULT_RECEIPT_DIR = ROOT / "harness/shared_factory/06-runs-and-logs/automation-run-tracking"
NOTION_VERSION = "2022-06-28"
SAFE_DELETE_BLOCK_TYPES = {
    "paragraph",
    "heading_1",
    "heading_2",
    "heading_3",
    "bulleted_list_item",
    "numbered_list_item",
    "to_do",
    "toggle",
    "quote",
    "callout",
    "divider",
    "code",
    "bookmark",
    "breadcrumb",
    "table_of_contents",
    "link_preview",
    "synced_block",
    "template",
    "column_list",
    "column",
    "table",
    "table_row",
}


class TrackingError(RuntimeError):
    """Raised for expected tracking failures."""


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def compact_id(value: str) -> str:
    return value.replace("-", "").strip()


def normalize_title(value: str) -> str:
    return value.replace("\u2019", "'").strip()


def load_manifest(path: Path) -> dict[str, Any]:
    if not path.exists():
        raise TrackingError(f"manifest not found: {path}")
    data = yaml.safe_load(path.read_text(encoding="utf-8"))
    if not isinstance(data, dict):
        raise TrackingError(f"manifest is not a mapping: {path}")
    return data


def env_from_login_shell(names: list[str]) -> dict[str, str]:
    shell = os.environ.get("SHELL") or "/bin/zsh"
    script = (
        "import json, os\n"
        f"names = {names!r}\n"
        "print(json.dumps({name: os.environ.get(name, '') for name in names}))\n"
    )
    proc = subprocess.run(
        [shell, "-lc", f"{sys.executable} - <<'PY'\n{script}PY"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        timeout=10,
    )
    if proc.returncode != 0:
        return {}
    try:
        loaded = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return {}
    return {str(k): str(v) for k, v in loaded.items()}


def get_notion_token(names: list[str]) -> str:
    for name in names:
        value = os.environ.get(name)
        if value:
            return value
    values = env_from_login_shell(names)
    for name in names:
        value = values.get(name)
        if value:
            return value
    raise TrackingError("No Genome Notion token found in expected environment variables.")


class NotionClient:
    def __init__(self, token: str, *, retries: int = 3, timeout: float = 30.0) -> None:
        self.token = token
        self.retries = retries
        self.timeout = timeout

    def request(self, method: str, path: str, body: dict[str, Any] | None = None) -> dict[str, Any]:
        url = f"https://api.notion.com/v1{path}"
        data = json.dumps(body).encode("utf-8") if body is not None else None
        headers = {
            "Authorization": f"Bearer {self.token}",
            "Notion-Version": NOTION_VERSION,
            "Content-Type": "application/json",
        }
        last_error = ""
        for attempt in range(1, self.retries + 1):
            req = urllib.request.Request(url, data=data, headers=headers, method=method)
            try:
                with urllib.request.urlopen(req, timeout=self.timeout) as response:
                    raw = response.read().decode("utf-8")
                    return json.loads(raw) if raw else {}
            except urllib.error.HTTPError as exc:
                raw = exc.read().decode("utf-8", errors="replace")
                last_error = raw
                if exc.code == 429 or 500 <= exc.code < 600:
                    time.sleep(min(2**attempt, 8))
                    continue
                raise TrackingError(f"Notion {method} {path} failed ({exc.code}): {raw}") from exc
            except urllib.error.URLError as exc:
                last_error = str(exc)
                time.sleep(min(2**attempt, 8))
        raise TrackingError(f"Notion {method} {path} exhausted retries: {last_error}")

    def list_children(self, block_id: str) -> list[dict[str, Any]]:
        children: list[dict[str, Any]] = []
        cursor: str | None = None
        while True:
            suffix = f"&start_cursor={cursor}" if cursor else ""
            data = self.request("GET", f"/blocks/{block_id}/children?page_size=100{suffix}")
            children.extend(data.get("results") or [])
            if not data.get("has_more"):
                return children
            cursor = data.get("next_cursor")


def rich(text: str, *, bold: bool = False) -> list[dict[str, Any]]:
    payload: dict[str, Any] = {"type": "text", "text": {"content": text[:2000]}}
    if bold:
        payload["annotations"] = {"bold": True}
    return [payload]


def paragraph(text: str, *, color: str = "default") -> dict[str, Any]:
    return {
        "object": "block",
        "type": "paragraph",
        "paragraph": {"rich_text": rich(text), "color": color},
    }


def heading(text: str, *, level: int = 2, color: str = "default") -> dict[str, Any]:
    block_type = f"heading_{level}"
    return {
        "object": "block",
        "type": block_type,
        block_type: {"rich_text": rich(text, bold=True), "color": color},
    }


def bullet(text: str, *, color: str = "default") -> dict[str, Any]:
    return {
        "object": "block",
        "type": "bulleted_list_item",
        "bulleted_list_item": {"rich_text": rich(text), "color": color},
    }


def callout(text: str, *, color: str = "blue_background") -> dict[str, Any]:
    return {
        "object": "block",
        "type": "callout",
        "callout": {"rich_text": rich(text, bold=True), "color": color},
    }


def divider() -> dict[str, Any]:
    return {"object": "block", "type": "divider", "divider": {}}


def title_from_page(page: dict[str, Any]) -> str:
    for prop in (page.get("properties") or {}).values():
        if prop.get("type") == "title":
            return "".join(part.get("plain_text", "") for part in prop.get("title") or [])
    return ""


def workspace_name(me: dict[str, Any]) -> str:
    bot = me.get("bot") or {}
    for key in ("workspace_name", "workspace"):
        value = bot.get(key)
        if isinstance(value, str):
            return value
    return ""


def verify_target(client: NotionClient, manifest: dict[str, Any], automation: dict[str, Any]) -> dict[str, str]:
    notion = manifest.get("notion") or {}
    expected_workspace = str(notion.get("workspace_expected") or "")
    parent_id = compact_id(str(notion.get("parent_page_id") or ""))
    page_id = compact_id(str(automation.get("page_id") or ""))
    expected_parent_title = normalize_title(str(notion.get("parent_title") or "Automations"))
    expected_ancestor_title = normalize_title(str(notion.get("parent_ancestor_title") or "Genome's Agentic OS"))

    me = client.request("GET", "/users/me")
    actual_workspace = workspace_name(me)
    if actual_workspace and expected_workspace and actual_workspace != expected_workspace:
        raise TrackingError(
            f"Refusing Notion write: expected workspace {expected_workspace}, got {actual_workspace}"
        )

    target = client.request("GET", f"/pages/{page_id}")
    target_parent = target.get("parent") or {}
    if target_parent.get("type") != "page_id" or compact_id(str(target_parent.get("page_id") or "")) != parent_id:
        raise TrackingError("Refusing Notion write: target page is not a child of the configured Automations page.")

    parent = client.request("GET", f"/pages/{parent_id}")
    parent_title = normalize_title(title_from_page(parent))
    if parent_title != expected_parent_title:
        raise TrackingError(f"Refusing Notion write: expected parent title {expected_parent_title}, got {parent_title}")

    ancestor_title = ""
    ancestor_parent = parent.get("parent") or {}
    if ancestor_parent.get("type") == "page_id":
        ancestor = client.request("GET", f"/pages/{compact_id(str(ancestor_parent.get('page_id')))}")
        ancestor_title = normalize_title(title_from_page(ancestor))
        if ancestor_title != expected_ancestor_title:
            raise TrackingError(
                f"Refusing Notion write: expected ancestor title {expected_ancestor_title}, got {ancestor_title}"
            )

    return {
        "workspace": actual_workspace or expected_workspace or "unknown",
        "parent_title": parent_title,
        "ancestor_title": ancestor_title,
        "target_title": title_from_page(target),
    }


def read_summary(args: argparse.Namespace) -> str:
    parts: list[str] = []
    if args.summary:
        parts.append(args.summary.strip())
    if args.summary_file:
        path = Path(args.summary_file).expanduser()
        if not path.exists():
            raise TrackingError(f"summary file not found: {path}")
        parts.append(path.read_text(encoding="utf-8", errors="replace").strip())
    text = "\n\n".join(part for part in parts if part)
    return text or "No summary text was provided. The runner reached automation summary closeout."


def split_paragraphs(text: str) -> list[str]:
    chunks: list[str] = []
    for raw in text.splitlines():
        line = raw.rstrip()
        if not line:
            continue
        while len(line) > 1900:
            chunks.append(line[:1900])
            line = line[1900:]
        chunks.append(line)
    return chunks or ["No summary text was provided."]


def status_color(status: str) -> str:
    normalized = status.strip().lower()
    if normalized in {"success", "succeeded", "complete", "completed", "configured", "ok"}:
        return "green_background"
    if normalized in {"failure", "failed", "error", "blocked", "timeout"}:
        return "red_background"
    if normalized in {"running", "in_progress", "in progress"}:
        return "blue_background"
    if normalized in {"paused", "skipped", "dry_run", "dry-run"}:
        return "yellow_background"
    return "purple_background"


def status_label(status: str) -> str:
    cleaned = status.strip().replace("_", " ")
    return cleaned.title() if cleaned else "Unknown"


def build_blocks(
    *,
    manifest: dict[str, Any],
    automation_id: str,
    automation: dict[str, Any],
    status: str,
    summary_text: str,
    evidence: list[str],
    started_at: str,
    finished_at: str,
    extra: list[str],
) -> list[dict[str, Any]]:
    run_finished_at = finished_at or utc_now()
    primary_color = status_color(status)
    automation_name = automation.get("name") or automation_id
    blocks: list[dict[str, Any]] = [
        callout(f"{automation_name} is {status_label(status)}", color=primary_color),
        heading("Latest Run Summary", level=1, color="blue"),
        paragraph(
            "This page is the current snapshot for the automation. It is replaced on each run so the top-level view stays readable.",
            color="gray_background",
        ),
        heading("Run Snapshot", color="blue"),
        bullet(f"Status: {status_label(status)}", color=primary_color),
        bullet(f"Finished at: {run_finished_at}", color="green_background"),
        bullet(f"Started at: {started_at or 'unknown'}", color="gray_background"),
        bullet(f"Schedule: {automation.get('schedule') or 'unspecified'}", color="blue_background"),
        bullet(f"Automation ID: {automation_id}", color="purple_background"),
    ]
    if evidence:
        blocks.extend([heading("Evidence", color="orange")])
        for item in evidence:
            blocks.append(bullet(item, color="orange_background"))
    else:
        blocks.append(bullet("Evidence: none provided by this run", color="yellow_background"))
    if automation.get("summary_source_hint"):
        blocks.append(bullet(f"Expected source: {automation['summary_source_hint']}", color="gray_background"))
    for item in extra:
        blocks.append(bullet(item, color="purple_background"))
    blocks.extend([divider(), heading("What Happened", color="purple")])
    blocks.extend(paragraph(chunk, color="default") for chunk in split_paragraphs(summary_text)[:60])
    blocks.extend(
        [
            divider(),
            heading("Tracking Contract", color="gray"),
            bullet("Single-page latest summary: no duplicate Notion pages per run.", color="gray_background"),
            bullet("Detailed history stays in local automation logs or durable run artifacts.", color="gray_background"),
            bullet("Thread Management Observe, Security Scan, and Dependabot keep their separate tracking surfaces.", color="gray_background"),
        ]
    )
    return blocks


def update_page_icon(client: NotionClient, page_id: str, automation: dict[str, Any]) -> None:
    icon = automation.get("icon")
    if not icon:
        return
    client.request("PATCH", f"/pages/{page_id}", {"icon": {"type": "emoji", "emoji": str(icon)}})


def replace_page(client: NotionClient, page_id: str, blocks: list[dict[str, Any]]) -> None:
    existing = client.list_children(page_id)
    unsafe = [block for block in existing if block.get("type") not in SAFE_DELETE_BLOCK_TYPES]
    if unsafe:
        labels = ", ".join(f"{block.get('type')}:{block.get('id')}" for block in unsafe[:10])
        raise TrackingError(f"Refusing to replace page with unsafe child blocks: {labels}")
    for block in existing:
        client.request("PATCH", f"/blocks/{compact_id(str(block.get('id')))}", {"archived": True})
    for offset in range(0, len(blocks), 100):
        client.request("PATCH", f"/blocks/{page_id}/children", {"children": blocks[offset : offset + 100]})


def write_receipt(receipt_dir: Path, automation_id: str, receipt: dict[str, Any]) -> None:
    receipt_dir.mkdir(parents=True, exist_ok=True)
    latest = receipt_dir / f"{automation_id}-latest.json"
    tmp = latest.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(receipt, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    tmp.replace(latest)


_SUMMARY_EPILOG = f"""\
ENVIRONMENT
  GENOMES_NOTION_PAT        Notion API token (primary). Required unless --dry-run.
  GENOMES_NOTION_CONNECTOR  Alternative Notion token (checked second when PAT is absent).
  AGENTIC_OS_ACTIVE_WORK_ITEM  Informational only; not used by this tool directly.

FILES
  automation-run-tracking.yml  Automation manifest (default: {DEFAULT_MANIFEST}).
  <receipt-dir>/<id>-latest.json  Local receipt written after each live or dry-run call.

EXAMPLES
  agentic-os-automation-run-summary --automation-id my-auto --status success --dry-run
      Preview the Notion blocks that would be written without sending any API calls.

  agentic-os-automation-run-summary --automation-id my-auto --status success \\
    --summary "Processed 42 items with no errors." --evidence "run_log=logs/run-001.md"
      Write a live summary to the automation's Notion page.

  agentic-os-automation-run-summary --automation-id my-auto --status failure \\
    --summary-file /tmp/my-summary.txt
      Use a file for the summary body (useful for long or multi-line summaries).
"""


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Replace an automation's Notion last-run summary page with the current run result. "
            "Reads automation config from the manifest, then replaces the page content in Notion. "
            "Pass --dry-run to preview the Notion blocks without making any API calls."
        ),
        epilog=_SUMMARY_EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "--automation-id",
        required=True,
        help="Automation slug matching a key in automation-run-tracking.yml. Required.",
    )
    parser.add_argument(
        "--status",
        default="unknown",
        help="Run outcome: success, failure, skipped, unknown, etc. (default: unknown).",
    )
    parser.add_argument(
        "--summary",
        help="Summary text to write as the 'What Happened' body. Mutually exclusive with --summary-file.",
    )
    parser.add_argument(
        "--summary-file",
        help="Path to a file whose content is used as the summary body. Mutually exclusive with --summary.",
    )
    parser.add_argument(
        "--evidence",
        action="append",
        default=[],
        help="Evidence bullet (e.g. 'run_log=path/to/log.md'). Repeatable.",
    )
    parser.add_argument("--started-at", default="", help="ISO timestamp when the run started.")
    parser.add_argument("--finished-at", default="", help="ISO timestamp when the run finished (default: now).")
    parser.add_argument(
        "--extra",
        action="append",
        default=[],
        help="Additional bullet text to append to the Run Snapshot section. Repeatable.",
    )
    parser.add_argument(
        "--manifest",
        type=Path,
        default=DEFAULT_MANIFEST,
        help=f"Path to automation-run-tracking.yml (default: {DEFAULT_MANIFEST}).",
    )
    parser.add_argument(
        "--receipt-dir",
        type=Path,
        default=DEFAULT_RECEIPT_DIR,
        help=f"Directory for local run receipt JSON files (default: {DEFAULT_RECEIPT_DIR}).",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help=(
            "Build Notion blocks and write a local receipt without calling the Notion API. "
            "Safe to run without Notion credentials."
        ),
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    try:
        manifest = load_manifest(args.manifest)
        automation_id = args.automation_id.strip()
        excluded = manifest.get("excluded_automations") or {}
        if automation_id in excluded:
            print(json.dumps({"status": "skipped", "reason": "excluded", "automation_id": automation_id}, indent=2))
            return 0

        automation = (manifest.get("automations") or {}).get(automation_id)
        if not automation:
            raise TrackingError(f"automation id is not configured for Notion run tracking: {automation_id}")

        summary_text = read_summary(args)
        page_id = compact_id(str(automation.get("page_id") or ""))
        if not page_id:
            raise TrackingError(f"automation id has no page_id: {automation_id}")

        blocks = build_blocks(
            manifest=manifest,
            automation_id=automation_id,
            automation=automation,
            status=args.status,
            summary_text=summary_text,
            evidence=args.evidence,
            started_at=args.started_at,
            finished_at=args.finished_at,
            extra=args.extra,
        )
        receipt = {
            "automation_id": automation_id,
            "automation_name": automation.get("name") or automation_id,
            "status": args.status,
            "updated_at": utc_now(),
            "page_id": page_id,
            "page_url": automation.get("page_url"),
            "dry_run": bool(args.dry_run),
            "evidence": args.evidence,
        }
        if args.dry_run:
            receipt["notion_write"] = "skipped_dry_run"
            print(json.dumps(receipt, indent=2, sort_keys=True))
            return 0

        token_names = [str(name) for name in (manifest.get("notion") or {}).get("token_env", [])]
        client = NotionClient(get_notion_token(token_names))
        receipt["verification"] = verify_target(client, manifest, automation)
        update_page_icon(client, page_id, automation)
        replace_page(client, page_id, blocks)
        receipt["notion_write"] = "updated"
        write_receipt(args.receipt_dir, automation_id, receipt)
        print(json.dumps(receipt, indent=2, sort_keys=True))
        return 0
    except TrackingError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
