DEFAULT_CONFIG_PATH = Path("/Users/genome/agentic_os/harness/registries/intake-sync.yml")
RUNS_LOG_DIR = Path(
    "/Users/genome/agentic_os/harness/shared_factory/06-runs-and-logs/intake-sync"
)
NOTION_DB_ID = "c442dd56a24340f0880acfd195f34225"
NOTION_API = "https://api.notion.com/v1"
NOTION_VERSION = "2022-06-28"

# Priority map: Notion P-value → Linear priority int (1=urgent, 4=low)
PRIORITY_MAP = {"P0": 1, "P1": 2, "P2": 3, "P3": 4}

# Linear state type → back-sync condition
LINEAR_DONE_TYPES = {"completed", "canceled"}
EXTERNAL_WRITE_BLOCK_PATTERNS = [
    ("local_path", re.compile(r"(?<![\w.-])/(?:Users|private|Volumes|tmp|var/folders)/[^\s)>\]]+")),
    ("notion_url", re.compile(r"https?://(?:www\.notion\.so|app\.notion\.com|[^/\s]+\.notion\.site)/[^\s)>\]]+")),
    ("token_value", re.compile(r"(?i)\b(?:lin_api|ntn|sk|secret|pat)_[A-Za-z0-9_-]{16,}\b|\bsk-[A-Za-z0-9_-]{16,}\b")),
]


# ---------------------------------------------------------------------------
# HTTP helpers
# ---------------------------------------------------------------------------


def _request(url: str, method: str = "GET", headers: dict = None, body=None, retries: int = 3) -> dict:
    data = json.dumps(body).encode() if body is not None else None
    for attempt in range(retries):
        req = urllib.request.Request(url, data=data, headers=headers or {}, method=method)
        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                return json.load(resp)
        except urllib.error.HTTPError as e:
            raw = e.read().decode(errors="replace")
            if e.code == 429 and attempt < retries - 1:
                # Back off the remaining Notion-only HTTP request path.
                wait = 65
                print(f"  [rate-limit] 429 on {url}, waiting {wait}s before retry {attempt + 2}/{retries}...")
                time.sleep(wait)
                continue
            raise RuntimeError(f"HTTP {e.code} {url}: {raw[:500]}") from e
    raise RuntimeError(f"All {retries} retries failed for {url}")


def notion_get(path: str, token: str) -> dict:
    return _request(
        f"{NOTION_API}{path}",
        headers={"Authorization": f"Bearer {token}", "Notion-Version": NOTION_VERSION},
    )


def notion_post(path: str, token: str, body: dict) -> dict:
    return _request(
        f"{NOTION_API}{path}",
        method="POST",
        headers={
            "Authorization": f"Bearer {token}",
            "Notion-Version": NOTION_VERSION,
            "Content-Type": "application/json",
        },
        body=body,
    )


def notion_patch(path: str, token: str, body: dict) -> dict:
    return _request(
        f"{NOTION_API}{path}",
        method="PATCH",
        headers={
            "Authorization": f"Bearer {token}",
            "Notion-Version": NOTION_VERSION,
            "Content-Type": "application/json",
        },
        body=body,
    )


# ---------------------------------------------------------------------------
# Notion helpers
# ---------------------------------------------------------------------------


def notion_query_all(db_id: str, token: str, verbose: bool = False) -> list:
    """Fetch all rows from a Notion database (handles pagination)."""
    rows = []
    cursor = None
    while True:
        body: dict = {"page_size": 100}
        if cursor:
            body["start_cursor"] = cursor
        resp = notion_post(f"/databases/{db_id}/query", token, body)
        rows.extend(resp.get("results", []))
        if not resp.get("has_more"):
            break
        cursor = resp.get("next_cursor")
    if verbose:
        print(f"  [notion] fetched {len(rows)} rows from DB {db_id}")
    return rows


def get_text(prop: dict) -> str:
    """Extract plain text from a Notion title or rich_text property."""
    items = prop.get("title") or prop.get("rich_text") or []
    return "".join(i.get("plain_text", "") for i in items)


def get_select(prop: dict) -> str | None:
    sel = prop.get("select")
    return sel.get("name") if sel else None


def get_url(prop: dict) -> str | None:
    return prop.get("url")


def get_page_body_excerpt(page_id: str, token: str, max_chars: int = 800) -> str:
    """Fetch top-level blocks and return a plain-text excerpt."""
    try:
        resp = notion_get(f"/blocks/{page_id}/children?page_size=20", token)
    except Exception:
        return ""
    parts = []
    for block in resp.get("results", []):
        btype = block.get("type", "")
        content = block.get(btype, {})
        rich = content.get("rich_text", [])
        text = "".join(r.get("plain_text", "") for r in rich).strip()
        if text:
            parts.append(text)
        if sum(len(p) for p in parts) > max_chars:
            break
    excerpt = "\n".join(parts)
    if len(excerpt) > max_chars:
        excerpt = excerpt[:max_chars] + "…"
    return excerpt


def external_write_findings(text: str) -> list[dict[str, str]]:
    findings: list[dict[str, str]] = []
    seen: set[str] = set()
    for code, pattern in EXTERNAL_WRITE_BLOCK_PATTERNS:
        if pattern.search(text or "") and code not in seen:
            findings.append(
                {
                    "code": code,
                    "message": f"blocked external write because content contains {code.replace('_', ' ')}",
                }
            )
            seen.add(code)
    return findings


def build_linear_description(page_id: str, body_excerpt: str) -> str:
    description = ""
    if body_excerpt:
        description += body_excerpt + "\n\n"
    description += f"---\n**Source:** OS Work Intake\nnotion:{page_id}"
    return description


def notion_set_linear_url(page_id: str, url: str, token: str) -> None:
    notion_patch(f"/pages/{page_id}", token, {"properties": {"Linear": {"url": url}}})


def notion_set_status(page_id: str, status_name: str, token: str) -> None:
    notion_patch(
        f"/pages/{page_id}",
        token,
        {"properties": {"Status": {"select": {"name": status_name}}}},
    )


# ---------------------------------------------------------------------------
# Linear helpers
# ---------------------------------------------------------------------------

_STATES_CACHE: dict[str, list] = {}


def _linear_client(token: str):
    return client_from_environment(token=token)


def linear_get_states(team_id: str, token: str) -> list:
    if team_id in _STATES_CACHE:
        return _STATES_CACHE[team_id]
    _STATES_CACHE[team_id] = _linear_client(token).request(
        "listWorkflowStates", {"teamId": team_id}
    )
    return _STATES_CACHE[team_id]


def resolve_state_id(name: str, states: list) -> str:
    """Find Linear state id by name (case-insensitive)."""
    for s in states:
        if s["name"].lower() == name.lower():
            return s["id"]
    raise RuntimeError(f"Linear state not found: {name!r}. Available: {[s['name'] for s in states]}")


def linear_get_labels(token: str, team_id: str | None = None) -> list:
    """Labels usable by the configured team: workspace-level labels plus the
    team's own. Labels owned by another team cannot be attached to this
    team's issues (Linear rejects with 'labelIds for incorrect team')."""
    return _linear_client(token).request(
        "listLabels", {**({"teamId": team_id} if team_id else {})}
    )


def linear_create_label(name: str, team_id: str, token: str) -> str:
    """Create a label and return its id. If it already exists, fetch and return the existing id."""
    try:
        label = _linear_client(token).request(
            "createLabel",
            {"input": {"name": name, "teamId": team_id, "color": "#5E6AD2"}},
        )
        return label["id"]
    except LinearBridgeError as e:
        if e.code == "CONFLICT":
            # Label already exists — fetch team-usable labels and find it
            labels = linear_get_labels(token, team_id)
            for lbl in labels:
                if lbl["name"].lower() == name.lower():
                    return lbl["id"]
            raise RuntimeError(f"Label {name!r} reported as duplicate but not found in label list") from e
        raise


def ensure_labels(names: list[str], existing: list, team_id: str, token: str, dry_run: bool) -> list[str]:
    """Return label ids, creating missing ones if not dry_run.

    Mutates `existing` in-place so the caller's list stays current across rows.
    """
    ids = []
    label_map = {l["name"]: l["id"] for l in existing}
    for name in names:
        if name in label_map:
            ids.append(label_map[name])
        else:
            if dry_run:
                print(f"  [dry-run] would create label {name!r}")
                ids.append(f"new-label:{name}")
            else:
                label_id = linear_create_label(name, team_id, token)
                label_map[name] = label_id
                # Keep the shared list in sync so future rows in this run find it
                existing.append({"id": label_id, "name": name})
                ids.append(label_id)
    return ids


def _has_exact_marker(description: object, marker: str) -> bool:
    return any(
        line.strip().strip("`") == marker
        for line in str(description or "").splitlines()
    )


def linear_search_by_marker(page_id: str, team_id: str, token: str) -> dict | None:
    """Search every visible team for the exact one-line intake marker."""
    marker = f"notion:{page_id}"
    client = _linear_client(token)
    teams = client.request("listTeams", {})
    team_ids = list(
        dict.fromkeys(
            [team_id]
            + [
                str(team.get("id"))
                for team in teams
                if isinstance(team, dict) and team.get("id")
            ]
        )
    )
    matches = []
    for visible_team_id in team_ids:
        issues = client.request(
            "listIssuesByTeam",
            {"teamId": visible_team_id, "includeArchived": True},
        )
        matches.extend(
            issue
            for issue in issues
            if _has_exact_marker(issue.get("description"), marker)
        )
    if len(matches) > 1:
        raise LinearBridgeError(
            "CONFLICT", "Linear idempotency marker matched multiple issues"
        )
    return matches[0] if matches else None


def linear_create_issue(
    title: str,
    description: str,
    state_id: str,
    priority: int,
    label_ids: list[str],
    team_id: str,
    project_id: str | None,
    token: str,
) -> dict:
    issue_input: dict = {
        "title": title,
        "description": description,
        "stateId": state_id,
        "priority": priority,
        "labelIds": [lid for lid in label_ids if not lid.startswith("new-label:")],
        "teamId": team_id,
    }
    if project_id:
        issue_input["projectId"] = project_id
    return _linear_client(token).request("createIssue", {"input": issue_input})


def linear_find_or_create_issue(
    marker: str,
    *,
    title: str,
    description: str,
    state_id: str,
    priority: int,
    label_ids: list[str],
    team_id: str,
    project_id: str | None,
    token: str,
) -> tuple[dict, bool]:
    issue_input: dict = {
        "title": title,
        "description": description,
        "stateId": state_id,
        "priority": priority,
        "labelIds": [lid for lid in label_ids if not lid.startswith("new-label:")],
        "teamId": team_id,
    }
    if project_id:
        issue_input["projectId"] = project_id
    result = _linear_client(token).request(
        "findOrCreateIssueByMarker", {"marker": marker, "input": issue_input}
    )
    if not isinstance(result, dict) or not isinstance(result.get("issue"), dict):
        raise LinearBridgeError(
            "BRIDGE_INVALID_RESPONSE",
            "Linear marker reconciliation returned invalid data",
        )
    if not isinstance(result.get("created"), bool):
        raise LinearBridgeError(
            "BRIDGE_INVALID_RESPONSE",
            "Linear marker reconciliation returned no creation status",
        )
    return result["issue"], result["created"]


def linear_update_issue(issue_id: str, state_id: str | None, priority: int | None, token: str) -> None:
    updates: dict = {}
    if state_id:
        updates["stateId"] = state_id
    if priority is not None:
        updates["priority"] = priority
    if not updates:
        return
    _linear_client(token).request(
        "updateIssue", {"issue": issue_id, "input": updates}
    )


def linear_get_issue(issue_url: str, token: str) -> dict | None:
    """Fetch a Linear issue by URL through the shared bridge's exact lookup."""
    # URL shape: https://linear.app/<team-slug>/issue/CC-182/some-slug
    parts = issue_url.rstrip("/").split("/")
    identifier = None
    for part in parts:
        # The identifier segment is TEAM-NUMBER (e.g. CC-182)
        segments = part.split("-")
        if len(segments) >= 2 and segments[0].isalpha() and segments[1].isdigit():
            identifier = f"{segments[0]}-{segments[1]}"
            break
    if not identifier:
        return None
    issue = _linear_client(token).request("getIssue", {"issue": identifier})
    return issue if isinstance(issue, dict) and issue.get("identifier") == identifier else None


def linear_get_team_sync_profile(team_id: str, token: str) -> dict:
    """Fetch read-only Linear metadata needed to validate intake sync config."""
    client = _linear_client(token)
    identity = client.request("preflightIdentity", {"teamId": team_id})
    team = identity.get("team") if isinstance(identity, dict) else None
    if not team:
        raise RuntimeError(f"Linear team not found: {team_id}")
    return {
        "team": {
            "id": team["id"],
            "name": team.get("name"),
            "key": team.get("key"),
        },
        "states": client.request("listWorkflowStates", {"teamId": team_id}),
        "projects": client.request("listProjects", {}),
    }


def linear_get_token_visibility(token: str) -> dict:
    """Fetch read-only viewer identity and visible teams for the configured Linear token."""
    client = _linear_client(token)
    teams = client.request("listTeams", {})
    identity = (
        client.request("preflightIdentity", {"teamId": teams[0]["id"]})
        if teams
        else {}
    )
    viewer = (identity.get("viewer") if isinstance(identity, dict) else None) or {}
    workspace = (identity.get("workspace") if isinstance(identity, dict) else None) or {}
    return {
        "viewer": {
            "id": viewer.get("id"),
            "name": viewer.get("name"),
            "email": viewer.get("email"),
        },
        "teams": [
            {"id": team.get("id"), "key": team.get("key"), "name": team.get("name")}
            for team in teams
        ],
        "workspace": {
            "id": workspace.get("id"),
            "name": workspace.get("name"),
            "urlKey": workspace.get("urlKey"),
        },
    }


def _linear_workspace_url_key(token: str) -> str | None:
    """Return the verified workspace slug or fail closed before sync."""
    client = _linear_client(token)
    teams = client.request("listTeams", {})
    if not teams:
        raise LinearBridgeError(
            "IDENTITY_MISMATCH", "Linear token has no visible team for workspace verification"
        )
    identity = client.request("preflightIdentity", {"teamId": teams[0]["id"]})
    url_key = ((identity.get("workspace") or {}).get("urlKey")) if isinstance(identity, dict) else None
    if not isinstance(url_key, str) or not url_key.strip():
        raise LinearBridgeError(
            "BRIDGE_INVALID_RESPONSE", "Linear workspace identity has no URL key"
        )
    return url_key.strip()


def _linear_url_workspace(url: str) -> str | None:
    match = re.match(r"https?://linear\.app/([^/]+)/", str(url or ""))
    return match.group(1) if match else None


def _linear_error_codes(exc: Exception) -> set[str]:
    code = getattr(exc, "code", None)
    return {str(code)} if code else set()


def _is_usage_limit_error(exc: Exception) -> bool:
    return bool(_linear_error_codes(exc) & {"USAGE_LIMITED", "USAGE_LIMIT_EXCEEDED"})


def _linear_sync_error_message(action: str, exc: Exception) -> str:
    if _is_usage_limit_error(exc):
        return (
            f"Linear {action} blocked: USAGE_LIMIT_EXCEEDED. "
            "Stop intake sync; the workspace issue limit must be resolved or the "
            "work must be routed to an approved tracker fallback."
        )
    return f"Linear {action} failed: {exc}"


def _team_label(cfg: dict) -> str:
    """Human-readable label for the configured Linear team (name / key, else id)."""
    team_name = cfg.get("team_name")
    team_key = cfg.get("team_key")
    if team_name and team_key:
        return f"{team_name} / {team_key}"
    if team_name or team_key:
        return str(team_name or team_key)
    return str(cfg.get("team_id") or "the configured Linear team")


def _viewer_label(viewer: dict) -> str:
    name = viewer.get("name") or viewer.get("email") or viewer.get("id")
    email = viewer.get("email")
    if email and name != email:
        return f"{name} ({email})"
    return str(name or "unknown user")


def _linear_token_env(cfg: dict) -> str:
    value = cfg.get("token_env")
    if isinstance(value, str) and value.strip():
        return value.strip()
    return "LINEAR_TOKEN"


def _linear_bridge_command_error() -> str | None:
    try:
        command = command_from_environment()
    except LinearBridgeError as exc:
        return str(exc)
    if not command:
        return "GENOMES_LINEAR_BRIDGE_COMMAND is not configured"
    return None


def _linear_token_remediation(team_label: str, token_env: str) -> str:
    return (
        f"Create a personal API key in the Linear workspace that owns team {team_label} "
        f"and export it as {token_env}, or use the project-approved connector-backed Linear "
        "path (Linear MCP / a composio user-key login session). Direct-token sync stays "
        "fail-closed until doctor passes; re-run doctor after the change."
    )


def _add_finding(findings: list[dict], severity: str, code: str, message: str, remediation: str) -> None:
    findings.append(
        {
            "severity": severity,
            "code": code,
            "message": message,
            "remediation": remediation,
        }
    )


def run_doctor(
    cfg: dict,
    *,
    config_path: Path,
    token_linear: str,
    token_notion: str,
    check_notion: bool = True,
) -> dict:
    """Read-only preflight for intake sync configuration and provider access."""
    checked_at = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    checks: list[dict] = []
    findings: list[dict] = []

    required_keys = ("team_id", "status_map", "project_map", "synced_statuses")
    missing_keys = [key for key in required_keys if key not in cfg]
    if missing_keys:
        _add_finding(
            findings,
            "blocker",
            "config_missing_keys",
            f"intake-sync config is missing required keys: {', '.join(missing_keys)}",
            "Add the missing keys to intake-sync.yml before running sync.",
        )
    checks.append(
        {
            "name": "config",
            "ok": not missing_keys,
            "path": str(config_path),
            "required_keys": list(required_keys),
        }
    )

    token_env = _linear_token_env(cfg)
    bridge_command_error = _linear_bridge_command_error()
    checks.append(
        {
            "name": "linear_bridge_command",
            "ok": bridge_command_error is None,
            **({"error": bridge_command_error} if bridge_command_error else {}),
        }
    )
    if bridge_command_error:
        _add_finding(
            findings,
            "blocker",
            "linear_bridge_unconfigured",
            bridge_command_error,
            "Set GENOMES_LINEAR_BRIDGE_COMMAND to the reviewed built Linear bridge and re-run doctor.",
        )
    if not token_linear:
        _add_finding(
            findings,
            "blocker",
            "missing_linear_token",
            f"{token_env} env var is not set.",
            f"Set {token_env} for the approved Linear workspace and re-run doctor.",
        )
    if check_notion and not token_notion:
        _add_finding(
            findings,
            "blocker",
            "missing_notion_token",
            "GENOMES_NOTION_PAT env var is not set.",
            "Set GENOMES_NOTION_PAT for Genome's Notion and re-run doctor.",
        )

    team_id = cfg.get("team_id")
    team_label = _team_label(cfg)
    token_check_ok = False
    if token_linear and not bridge_command_error:
        try:
            visibility = linear_get_token_visibility(token_linear)
            visible_teams = visibility["teams"]
            team_visible = bool(team_id) and any(
                str(team.get("id")) == str(team_id) for team in visible_teams
            )
            workspace = visibility.get("workspace") or {}
            workspace_identity_ok = bool(workspace.get("urlKey"))
            token_check_ok = (team_visible or not team_id) and workspace_identity_ok
            checks.append(
                {
                    "name": "linear_token",
                    "ok": bool(token_check_ok),
                    "viewer": visibility["viewer"],
                    "visible_teams": visible_teams,
                    "configured_team_id": team_id,
                    "configured_team_visible": team_visible,
                    "workspace": workspace,
                    "workspace_identity_verified": workspace_identity_ok,
                }
            )
            if not workspace_identity_ok:
                _add_finding(
                    findings,
                    "blocker",
                    "linear_workspace_identity_unavailable",
                    "Linear bridge preflight did not return a verified workspace URL key.",
                    "Verify the reviewed Linear bridge command and token, then re-run doctor.",
                )
            if team_id and not team_visible:
                visible_label = ", ".join(
                    f"{team.get('name')} ({team.get('key')})" for team in visible_teams
                ) or "no teams"
                _add_finding(
                    findings,
                    "blocker",
                    "linear_team_not_visible",
                    (
                        f"{token_env} authenticates as {_viewer_label(visibility['viewer'])} "
                        f"but cannot see configured Linear team {team_label} "
                        f"(team_id {team_id}); visible teams: {visible_label}."
                    ),
                    _linear_token_remediation(team_label, token_env),
                )
        except Exception as exc:
            checks.append(
                {
                    "name": "linear_token",
                    "ok": False,
                    "error_codes": sorted(_linear_error_codes(exc)),
                }
            )
            _add_finding(
                findings,
                "blocker",
                "linear_token_invalid",
                _linear_sync_error_message("token visibility check", exc),
                _linear_token_remediation(team_label, token_env),
            )

    if token_linear and team_id and token_check_ok:
        try:
            profile = linear_get_team_sync_profile(team_id, token_linear)
            states = profile["states"]
            projects = profile["projects"]
            checks.append(
                {
                    "name": "linear_team",
                    "ok": True,
                    "team": profile["team"],
                    "states": [state.get("name") for state in states],
                    "projects": [
                        {"id": project.get("id"), "name": project.get("name")}
                        for project in projects
                    ],
                }
            )

            state_names = {str(state.get("name", "")).lower() for state in states}
            for notion_status, mapping in (cfg.get("status_map") or {}).items():
                state_name = mapping.get("state") if isinstance(mapping, dict) else mapping
                if state_name and str(state_name).lower() not in state_names:
                    _add_finding(
                        findings,
                        "blocker",
                        "missing_linear_state",
                        f"status_map[{notion_status!r}] points at missing Linear state {state_name!r}.",
                        "Update intake-sync.yml status_map or create/rename the Linear workflow state.",
                    )

            project_ids = {str(project.get("id")) for project in projects if project.get("id")}
            for notion_project, project_id in (cfg.get("project_map") or {}).items():
                if project_id and str(project_id) not in project_ids:
                    _add_finding(
                        findings,
                        "blocker",
                        "missing_linear_project",
                        f"project_map[{notion_project!r}] points at Linear project id {project_id!r}, which is not visible in the verified workspace.",
                        "Update intake-sync.yml project_map to a verified workspace-visible Linear project id.",
                    )
        except Exception as exc:
            code = "linear_usage_limit_exceeded" if _is_usage_limit_error(exc) else "linear_doctor_failed"
            remediation = (
                "Resolve the Linear workspace issue limit or route this work to the approved tracker fallback before running sync."
                if _is_usage_limit_error(exc)
                else f"Verify {token_env}, team_id, and Linear API access, then re-run doctor."
            )
            _add_finding(findings, "blocker", code, _linear_sync_error_message("doctor", exc), remediation)
            checks.append(
                {
                    "name": "linear_team",
                    "ok": False,
                    "team_id": team_id,
                    "error_codes": sorted(_linear_error_codes(exc)),
                }
            )

    if check_notion and token_notion:
        try:
            db = notion_get(f"/databases/{NOTION_DB_ID}", token_notion)
            title = "".join(
                part.get("plain_text", "")
                for part in db.get("title", [])
                if isinstance(part, dict)
            )
            checks.append(
                {
                    "name": "notion_database",
                    "ok": True,
                    "database_id": NOTION_DB_ID,
                    "title": title,
                }
            )
        except Exception as exc:
            _add_finding(
                findings,
                "blocker",
                "notion_database_unavailable",
                f"Cannot read OS Work Intake Notion database {NOTION_DB_ID}: {exc}",
                "Verify the token is for Genome's Notion and has access to the OS Work Intake database.",
            )
            checks.append({"name": "notion_database", "ok": False, "database_id": NOTION_DB_ID})

    checks.append(
        {
            "name": "issue_creation_quota",
            "ok": True,
            "mode": "read_only",
            "note": "Linear issue creation quota cannot be proven without a mutation; any USAGE_LIMIT_EXCEEDED response is classified as a blocker.",
        }
    )

    blocker_count = sum(1 for finding in findings if finding["severity"] == "blocker")
    return {
        "ok": blocker_count == 0,
        "checked_at": checked_at,
        "config": str(config_path),
        "notion_db_id": NOTION_DB_ID,
        "blocker_count": blocker_count,
        "checks": checks,
        "findings": findings,
    }


# ---------------------------------------------------------------------------
# Config loading
# ---------------------------------------------------------------------------


def load_config(path: Path) -> dict:
    with open(path) as f:
        return yaml.safe_load(f)


# ---------------------------------------------------------------------------
# Row → issue plan
# ---------------------------------------------------------------------------


def row_to_plan(
    row: dict,
    cfg: dict,
    states: list,
    labels: list,
    team_id: str,
    token: str,
    verbose: bool,
    dry_run: bool,
) -> dict:
    """Build a plan dict for one Notion row."""
    props = row["properties"]
    page_id = row["id"]
    name = get_text(props.get("Name", {}))
    status = get_select(props.get("Status", {})) or "inbox"
    project_notion = get_select(props.get("Project", {}))
    priority_str = get_select(props.get("Priority", {}))
    type_str = get_select(props.get("Type", {}))
    linear_url = get_url(props.get("Linear", {}))

    synced_statuses = set(cfg.get("synced_statuses", []))
    sync_inbox = cfg.get("sync_inbox", False)

    # Decide action
    # Jira-tracked rows are execution items owned by the Jira/PR dashboards;
    # mirroring them to Linear would double-track the same work.
    jira_tracked = bool(props.get("Jira Tracked", {}).get("checkbox", False))
    if jira_tracked and cfg.get("skip_jira_tracked", True):
        return {"action": "skip", "reason": "jira tracked (excluded from Linear sync)", "page_id": page_id, "name": name}
    if status == "inbox" and not sync_inbox:
        return {"action": "skip", "reason": "inbox excluded", "page_id": page_id, "name": name}
    if status not in synced_statuses and status != "inbox":
        return {"action": "skip", "reason": f"status {status!r} not in synced_statuses", "page_id": page_id, "name": name}

    # Map status → Linear state name
    status_map = cfg.get("status_map", {})
    linear_state_name = status_map.get(status, {}).get("state") if isinstance(status_map.get(status), dict) else status_map.get(status)
    if not linear_state_name:
        return {"action": "skip", "reason": f"no status_map entry for {status!r}", "page_id": page_id, "name": name}

    state_id = resolve_state_id(linear_state_name, states)
    priority = PRIORITY_MAP.get(priority_str or "", 3)

    # Labels
    label_cfg = cfg.get("label_map", {})
    label_names = list(label_cfg.get("always", []))
    if type_str and type_str in label_cfg.get("type_map", {}):
        label_names.append(label_cfg["type_map"][type_str])
    if status == "blocked":
        blocked_label = label_cfg.get("blocked_label", "blocked")
        label_names.append(blocked_label)

    # Project id
    project_map = cfg.get("project_map", {})
    project_id = project_map.get(project_notion) if project_notion else None

    plan = {
        "action": "update" if linear_url else "create",
        "page_id": page_id,
        "name": name,
        "status": status,
        "linear_state_name": linear_state_name,
        "state_id": state_id,
        "priority": priority,
        "label_names": label_names,
        "project_id": project_id,
        "linear_url": linear_url,
        "type_str": type_str,
        "project_notion": project_notion,
    }
    return plan


# ---------------------------------------------------------------------------
# Execute
# ---------------------------------------------------------------------------


def execute_push(
    rows: list,
    cfg: dict,
    states: list,
    labels: list,
    team_id: str,
    token_linear: str,
    token_notion: str,
    dry_run: bool,
    verbose: bool,
    limit: int | None,
) -> dict:
    """Forward sync: Notion → Linear."""
    # Sort by Created ascending for deterministic candidate set
    rows_sorted = sorted(
        rows,
        key=lambda r: r["properties"].get("Created", {}).get("created_time", ""),
    )

    # Apply limit to CANDIDATE SET (not creation count) to ensure idempotency
    candidates = rows_sorted[:limit] if limit is not None else rows_sorted

    counts = {"created": 0, "updated": 0, "skipped": 0, "errors": 0}
    try:
        workspace_url_key = _linear_workspace_url_key(token_linear)
    except Exception as exc:
        print(
            f"  ERROR: {_linear_sync_error_message('workspace identity check', exc)}",
            file=sys.stderr,
        )
        counts["errors"] = 1
        return counts

    for row in candidates:
        try:
            plan = row_to_plan(row, cfg, states, labels, team_id, token_linear, verbose, dry_run)
        except Exception as e:
            print(f"  ERROR planning row {row.get('id','?')}: {e}", file=sys.stderr)
            counts["errors"] += 1
            continue

        if plan["action"] == "skip":
            if verbose:
                print(f"  skip  {plan['name']!r}: {plan['reason']}")
            counts["skipped"] += 1
            continue

        page_id = plan["page_id"]
        name = plan["name"]

        if plan["action"] == "create":
            # Belt-and-suspenders: search Linear for existing issue by marker.
            # Skip in dry-run: nothing has been created yet so no dupes possible,
            # and 61 searches would exhaust the 30/min rate limit.
            try:
                existing = None if dry_run else linear_search_by_marker(page_id, team_id, token_linear)
            except Exception as e:
                print(f"  ERROR {name!r}: {_linear_sync_error_message('duplicate search', e)}", file=sys.stderr)
                counts["errors"] += 1
                if _is_usage_limit_error(e):
                    break
                continue
            if existing:
                if verbose:
                    print(f"  skip  {name!r}: already in Linear as {existing['identifier']} (marker found)")
                # Write URL back if missing in Notion
                if not plan["linear_url"]:
                    if not dry_run:
                        notion_set_linear_url(page_id, existing["url"], token_notion)
                    if verbose:
                        print(f"         wrote URL back to Notion: {existing['url']}")
                counts["skipped"] += 1
                continue

            # Build description
            body_excerpt = get_page_body_excerpt(page_id, token_notion)
            description = build_linear_description(page_id, body_excerpt)
            external_findings = external_write_findings(f"{name}\n{description}")
            if external_findings:
                codes = ", ".join(finding["code"] for finding in external_findings)
                print(f"  ERROR {name!r}: external-write scrubber blocked Linear create ({codes})", file=sys.stderr)
                counts["errors"] += 1
                continue

            label_ids = ensure_labels(plan["label_names"], labels, team_id, token_linear, dry_run)

            if dry_run:
                print(
                    f"  CREATE {name!r} | status={plan['status']} → {plan['linear_state_name']}"
                    f" | priority={plan['priority']} | project={plan['project_notion']!r}"
                    f" | labels={plan['label_names']}"
                )
                counts["created"] += 1
                continue

            try:
                issue, created = linear_find_or_create_issue(
                    f"notion:{page_id}",
                    title=name,
                    description=description,
                    state_id=plan["state_id"],
                    priority=plan["priority"],
                    label_ids=label_ids,
                    team_id=team_id,
                    project_id=plan["project_id"],
                    token=token_linear,
                )
            except Exception as e:
                print(f"  ERROR {name!r}: {_linear_sync_error_message('issue creation', e)}", file=sys.stderr)
                counts["errors"] += 1
                if _is_usage_limit_error(e):
                    break
                continue
            if not created:
                notion_set_linear_url(page_id, issue["url"], token_notion)
                if verbose:
                    print(
                        f"  skip  {name!r}: bridge reconciliation reused "
                        f"{issue['identifier']}"
                    )
                counts["skipped"] += 1
                continue
            # Write URL back immediately
            notion_set_linear_url(page_id, issue["url"], token_notion)
            print(f"  CREATED {issue['identifier']} ← {name!r} → {issue['url']}")
            counts["created"] += 1

        elif plan["action"] == "update":
            # Row already has Linear URL — check for drift in state/priority
            linear_url = plan["linear_url"]
            url_workspace = _linear_url_workspace(linear_url)
            if workspace_url_key and url_workspace and url_workspace != workspace_url_key:
                print(
                    f"  skip  {name!r}: linked issue lives in Linear workspace "
                    f"'{url_workspace}' (this config syncs '{workspace_url_key}')"
                )
                counts["skipped"] += 1
                continue
            try:
                linear_issue = linear_get_issue(linear_url, token_linear)
            except Exception as e:
                if verbose:
                    print(f"  WARN  could not fetch Linear issue for {name!r}: {e}")
                counts["errors"] += 1
                continue

            if not linear_issue:
                if verbose:
                    print(f"  WARN  Linear issue not found for {name!r} at {linear_url}")
                counts["errors"] += 1
                continue

            current_state = linear_issue["state"]["name"]
            current_priority = linear_issue.get("priority", 0)
            desired_state = plan["linear_state_name"]
            desired_priority = plan["priority"]

            drifted_state = current_state.lower() != desired_state.lower()
            drifted_priority = current_priority != desired_priority

            if drifted_state or drifted_priority:
                if dry_run:
                    print(
                        f"  UPDATE {name!r} | state: {current_state!r}→{desired_state!r}"
                        f" | priority: {current_priority}→{desired_priority}"
                    )
                    counts["updated"] += 1
                else:
                    linear_update_issue(
                        linear_issue["id"],
                        plan["state_id"] if drifted_state else None,
                        desired_priority if drifted_priority else None,
                        token_linear,
                    )
                    print(f"  UPDATED {linear_issue['identifier']} {name!r}")
                    counts["updated"] += 1
            else:
                if verbose:
                    print(f"  ok    {name!r}: in sync")
                counts["skipped"] += 1

    return counts


def execute_pull(
    rows: list,
    cfg: dict,
    team_id: str,
    token_linear: str,
    token_notion: str,
    dry_run: bool,
    verbose: bool,
) -> dict:
    """Back sync: if Linear issue is completed/canceled and Notion isn't done/dropped → update Notion."""
    counts = {"backsynced": 0, "skipped": 0, "errors": 0}
    try:
        workspace_url_key = _linear_workspace_url_key(token_linear)
    except Exception as exc:
        print(
            f"  ERROR: {_linear_sync_error_message('workspace identity check', exc)}",
            file=sys.stderr,
        )
        counts["errors"] = 1
        return counts

    # Only rows that have a Linear URL
    linked = [r for r in rows if get_url(r["properties"].get("Linear", {}))]
    if verbose:
        print(f"  [pull] {len(linked)} rows with Linear URLs")

    for row in linked:
        props = row["properties"]
        page_id = row["id"]
        name = get_text(props.get("Name", {}))
        notion_status = get_select(props.get("Status", {})) or "inbox"
        linear_url = get_url(props.get("Linear", {}))

        if notion_status in ("done", "dropped"):
            counts["skipped"] += 1
            continue

        url_workspace = _linear_url_workspace(linear_url)
        if workspace_url_key and url_workspace and url_workspace != workspace_url_key:
            counts["skipped"] += 1
            continue

        try:
            linear_issue = linear_get_issue(linear_url, token_linear)
        except Exception as e:
            if verbose:
                print(f"  WARN  pull: could not fetch {name!r}: {e}")
            counts["errors"] += 1
            continue

        if not linear_issue:
            counts["skipped"] += 1
            continue

        state_type = linear_issue["state"]["type"]
        state_name = linear_issue["state"]["name"]

        if state_type in LINEAR_DONE_TYPES:
            # Map to Notion status
            if state_type == "completed":
                new_status = "done"
            else:  # canceled or duplicate
                new_status = "dropped"

            if dry_run:
                print(f"  BACK-SYNC {name!r}: Notion {notion_status!r} → {new_status!r} (Linear: {state_name})")
                counts["backsynced"] += 1
            else:
                notion_set_status(page_id, new_status, token_notion)
                print(f"  BACK-SYNCED {name!r}: Notion → {new_status!r}")
                counts["backsynced"] += 1
        else:
            counts["skipped"] += 1

    return counts


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="agentic-os-intake-sync",
        description=(
            "Sync the OS Work Intake Notion database to Linear (Clarks Consulting team). "
            "Creates/updates Linear issues for rows in synced statuses, writes "
            "issue URLs back to Notion, and back-syncs completed/canceled states."
        ),
        epilog="""
ENVIRONMENT:
  LINEAR_TOKEN        Linear personal API token, passed only to the reviewed bridge child.
                      Override the host env var name via `token_env` in intake-sync.yml.
  GENOMES_LINEAR_BRIDGE_COMMAND
                      Command for the reviewed built Linear bridge entrypoint.
  GENOMES_NOTION_PAT  Notion integration token for Genome's Notion workspace.

FILES:
  /Users/genome/agentic_os/harness/registries/intake-sync.yml
      Config: team_id, project_map, status_map, label_map, synced_statuses, sync_inbox.

EXAMPLES:
  # Dry run — see the full plan, no changes written
  agentic-os-intake-sync --dry-run

  # Real run, limit candidate set to first 3 rows (by Created asc)
  agentic-os-intake-sync --limit 3

  # Push-only sync with verbose output
  agentic-os-intake-sync --direction push --verbose

  # Back-sync only (Linear → Notion status updates)
  agentic-os-intake-sync --direction pull

  # Read-only provider/config preflight
  agentic-os-intake-sync doctor

  # Filter to specific Notion status
  agentic-os-intake-sync --status-filter triaged --dry-run

  # Filter to one exact Notion title
  agentic-os-intake-sync --title-filter 'Big spec' --dry-run
""",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "command",
        nargs="?",
        choices=["doctor"],
        help="Run a read-only preflight instead of syncing.",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        default=False,
        help="Print the plan without making any changes.",
    )
    parser.add_argument(
        "--limit",
        type=int,
        default=None,
        metavar="N",
        help=(
            "Examine only the first N candidate rows (sorted by Created ascending). "
            "Applying the same --limit on re-run proves idempotency: 0 new issues created."
        ),
    )
    parser.add_argument(
        "--direction",
        choices=["push", "pull", "both"],
        default="both",
        help=(
            "push = Notion→Linear only; pull = Linear→Notion back-sync only; "
            "both = run both directions (default)."
        ),
    )
    parser.add_argument(
        "--status-filter",
        default=None,
        metavar="STATUS",
        help="Only process rows with this Notion status (e.g. triaged, queued).",
    )
    parser.add_argument(
        "--title-filter",
        default=None,
        metavar="TITLE",
        help="Only process rows whose Notion Name title exactly matches TITLE.",
    )
    parser.add_argument(
        "--verbose",
        "-v",
        action="store_true",
        default=False,
        help="Print details for every row including skipped ones.",
    )
    parser.add_argument(
        "--config",
        default=str(DEFAULT_CONFIG_PATH),
        metavar="PATH",
        help=f"Path to intake-sync.yml (default: {DEFAULT_CONFIG_PATH}).",
    )

    args = parser.parse_args()

    # Load config (before tokens: config may override the Linear token env var name)
    config_path = Path(args.config)
    if not config_path.exists():
        print(f"ERROR: Config not found at {config_path}", file=sys.stderr)
        sys.exit(1)
    cfg = load_config(config_path) or {}

    # Tokens from environment
    linear_token_env = _linear_token_env(cfg)
    token_linear = os.environ.get(linear_token_env, "")
    token_notion = os.environ.get("GENOMES_NOTION_PAT", "")
    if args.command != "doctor" and not token_linear:
        print(f"ERROR: {linear_token_env} env var is not set.", file=sys.stderr)
        sys.exit(1)
    if args.command != "doctor" and not token_notion:
        print("ERROR: GENOMES_NOTION_PAT env var is not set.", file=sys.stderr)
        sys.exit(1)

    bridge_command_error = _linear_bridge_command_error()
    if args.command != "doctor" and bridge_command_error:
        print(f"ERROR: Linear bridge unavailable: {bridge_command_error}.", file=sys.stderr)
        sys.exit(1)

    if args.command == "doctor":
        result = run_doctor(
            cfg,
            config_path=config_path,
            token_linear=token_linear,
            token_notion=token_notion,
        )
        print(yaml.safe_dump(result, sort_keys=False))
        sys.exit(0 if result["ok"] else 1)

    team_id = cfg["team_id"]
    if args.dry_run:
        print("=== DRY RUN — no changes will be written ===\n")

    # Fetch Notion rows
    print("Fetching Notion rows...")
    rows = notion_query_all(NOTION_DB_ID, token_notion, verbose=args.verbose)
    print(f"Fetched {len(rows)} rows from Notion DB.")

    # Apply status filter if requested
    if args.status_filter:
        rows = [
            r for r in rows
            if get_select(r["properties"].get("Status", {})) == args.status_filter
        ]
        print(f"Filtered to {len(rows)} rows with status={args.status_filter!r}.")
    if args.title_filter:
        rows = [
            r for r in rows
            if get_text(r["properties"].get("Name", {})) == args.title_filter
        ]
        print(f"Filtered to {len(rows)} rows with title={args.title_filter!r}.")

    # Fetch Linear states and labels (runtime, not hardcoded IDs)
    print("Fetching Linear states and labels...")
    states = linear_get_states(team_id, token_linear)
    labels = linear_get_labels(token_linear, team_id)

    # Run sync
    run_counts: dict = {"created": 0, "updated": 0, "backsynced": 0, "skipped": 0, "errors": 0}

    if args.direction in ("push", "both"):
        print("\n--- PUSH: Notion → Linear ---")
        push_counts = execute_push(
            rows=rows,
            cfg=cfg,
            states=states,
            labels=labels,
            team_id=team_id,
            token_linear=token_linear,
            token_notion=token_notion,
            dry_run=args.dry_run,
            verbose=args.verbose,
            limit=args.limit,
        )
        run_counts["created"] += push_counts["created"]
        run_counts["updated"] += push_counts["updated"]
        run_counts["skipped"] += push_counts["skipped"]
        run_counts["errors"] += push_counts["errors"]

    if args.direction in ("pull", "both"):
        print("\n--- PULL: Linear → Notion back-sync ---")
        pull_counts = execute_pull(
            rows=rows,
            cfg=cfg,
            team_id=team_id,
            token_linear=token_linear,
            token_notion=token_notion,
            dry_run=args.dry_run,
            verbose=args.verbose,
        )
        run_counts["backsynced"] += pull_counts["backsynced"]
        run_counts["skipped"] += pull_counts.get("skipped", 0)
        run_counts["errors"] += pull_counts["errors"]

    # Summary
    print(
        f"\nRun complete — created={run_counts['created']} updated={run_counts['updated']}"
        f" backsynced={run_counts['backsynced']} skipped={run_counts['skipped']}"
        f" errors={run_counts['errors']}"
    )

    # Write run receipt
    ts = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    receipt = {
        "timestamp": ts,
        "dry_run": args.dry_run,
        "direction": args.direction,
        "limit": args.limit,
        "status_filter": args.status_filter,
        "title_filter": args.title_filter,
        "notion_db_id": NOTION_DB_ID,
        "rows_fetched": len(rows),
        "counts": run_counts,
    }
    RUNS_LOG_DIR.mkdir(parents=True, exist_ok=True)
    receipt_path = RUNS_LOG_DIR / f"{ts}.json"
    with open(receipt_path, "w") as f:
        json.dump(receipt, f, indent=2)
    print(f"Receipt: {receipt_path}")
    if run_counts["errors"]:
        sys.exit(1)


if __name__ == "__main__":
    main()
