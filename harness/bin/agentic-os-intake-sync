#!/usr/bin/env python3
"""agentic-os-intake-sync - Sync OS Work Intake Notion database to Linear (Clarks Consulting team).

Reads the "🧭 OS Work Intake" Notion database and creates/updates Linear issues
for rows in synced statuses. Also back-syncs Linear completed/canceled state
to Notion when the Notion row hasn't been updated.

ENVIRONMENT
  LINEAR_TOKEN       Linear personal API token (no "Bearer " prefix).
                     Config key `token_env` in intake-sync.yml overrides the
                     env var name (e.g. LINEAR_CC_TOKEN) so multi-workspace
                     setups keep one token per tracker config.
  GENOMES_NOTION_PAT Notion integration token for Genome's Notion.

FILES
  /Users/genome/agentic_os/harness/registries/intake-sync.yml
      Team ID, project map, status map, label map, sync config.

EXAMPLES
  # Dry run — prints plan, no changes
  agentic-os-intake-sync --dry-run

  # Dry run one exact row by Notion title
  agentic-os-intake-sync --dry-run --title-filter "Conversation Report OS Hardening Portfolio"

  # Real run, limit to first 3 candidates (by Created asc)
  agentic-os-intake-sync --limit 3

  # Push-only, verbose
  agentic-os-intake-sync --direction push --verbose

  # Pull-only (back-sync Linear→Notion)
  agentic-os-intake-sync --direction pull

  # Read-only preflight: token workspace visibility, Notion/Linear access, mapping drift
  agentic-os-intake-sync doctor
"""

import argparse
import importlib.util
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timezone
from pathlib import Path


def _release_version_key(candidate: Path) -> tuple[int, ...]:
    match = re.match(r"^(\d+(?:\.\d+)*)", candidate.parents[2].name)
    if match is None:
        return (-1,)
    return tuple(int(part) for part in match.group(1).split("."))


def _ensure_agentic_os_runtime() -> None:
    """Re-exec under a source or installed package runtime when necessary."""
    repository = Path(__file__).resolve().parents[2]
    source = repository / "src"
    if (source / "genomes_agentic_os" / "linear_bridge.py").is_file():
        sys.path.insert(0, str(source))
    try:
        bridge_spec = importlib.util.find_spec("genomes_agentic_os.linear_bridge")
    except ModuleNotFoundError:
        bridge_spec = None
    if bridge_spec is not None:
        return
    candidates: list[Path] = []
    configured = os.environ.get("AGENTIC_OS_PYTHON", "").strip()
    if configured:
        candidates.append(Path(configured).expanduser())
    releases = Path.home() / "Library" / "Application Support" / "AgenticOS" / "releases"
    candidates.extend(
        sorted(
            releases.glob("*/runtime/bin/python"),
            key=_release_version_key,
            reverse=True,
        )
        if releases.is_dir()
        else []
    )
    for candidate in candidates:
        if not candidate.is_file() or not os.access(candidate, os.X_OK):
            continue
        try:
            probe = subprocess.run(
                [str(candidate), "-c", "import genomes_agentic_os.linear_bridge"],
                check=False,
                capture_output=True,
                text=True,
                timeout=10,
            )
            if probe.returncode == 0:
                os.execve(
                    str(candidate),
                    [str(candidate), __file__, *sys.argv[1:]],
                    dict(os.environ),
                )
        except (OSError, subprocess.TimeoutExpired):
            continue
    raise SystemExit(
        "ERROR: agentic-os-intake-sync requires an Agentic OS runtime containing "
        "the shared Linear bridge; install the reviewed release or set "
        "AGENTIC_OS_PYTHON"
    )


_ensure_agentic_os_runtime()

from genomes_agentic_os.linear_bridge import (
    LinearBridgeError,
    client_from_environment,
    command_from_environment,
)

try:
    import yaml
except ImportError:
    print("ERROR: PyYAML is required. Install with: pip install pyyaml", file=sys.stderr)
    sys.exit(1)

