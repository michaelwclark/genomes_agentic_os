#!/usr/bin/env python3
"""Compatibility launcher for the universal long-running execution contract."""

from __future__ import annotations

from datetime import datetime, timezone
import importlib.util
import os
from pathlib import Path
import re
import sys


def _slug(value: str) -> str:
    return re.sub(r"[^A-Za-z0-9]+", "-", value.strip().lower()).strip("-")[:48] or "quiet-run"


def generated_run_id(async_root: Path, label: str) -> str:
    """Retain the legacy helper used by naming regression tests and adapters."""
    os_root = next(
        (candidate for candidate in (async_root, *async_root.parents) if (candidate / ".agentic_root").is_file()),
        Path(os.environ.get("AGENTIC_OS_ROOT", "~/agentic_os")).expanduser(),
    )
    enabled, date_format, separator = True, "%m%d%y", "-"
    config = os_root / "harness/config/artifact-naming.yml"
    if config.is_file():
        import yaml

        loaded = yaml.safe_load(config.read_text(encoding="utf-8")) or {}
        prefix = (loaded.get("artifact_naming") or {}).get("date_prefix") or {}
        enabled = bool(prefix.get("enabled", True)) and bool(
            (prefix.get("scopes") or {}).get("async_runs", True)
        )
        date_format = str(prefix.get("format") or date_format)
        separator = str(prefix.get("separator") or separator)
    current = datetime.now(timezone.utc)
    suffix = f"{current.strftime('%H%M%S')}-{_slug(label)}"
    return f"{current.strftime(date_format)}{separator}{suffix}" if enabled else suffix


def main() -> None:
    repository = Path(__file__).resolve().parents[2]
    source = repository / "src"
    if (source / "genomes_agentic_os").is_dir():
        environment = dict(os.environ)
        environment["PYTHONPATH"] = str(source) + os.pathsep + environment.get("PYTHONPATH", "")
        os.execve(
            sys.executable,
            [sys.executable, "-m", "genomes_agentic_os.cli", "long-run", *sys.argv[1:]],
            environment,
        )
    if importlib.util.find_spec("genomes_agentic_os") is not None:
        os.execv(
            sys.executable,
            [sys.executable, "-m", "genomes_agentic_os.cli", "long-run", *sys.argv[1:]],
        )
    configured = os.environ.get("AGENTIC_OS_CLI")
    installed = Path.home() / ".local/bin/agentic-os-source"
    if configured:
        cli = Path(configured).expanduser()
    elif installed.is_file() and os.access(installed, os.X_OK):
        cli = installed
    else:
        cli = None
    if cli is not None and cli.resolve() != Path(__file__).resolve():
        os.execv(str(cli), [str(cli), "long-run", *sys.argv[1:]])
    os.execv(
        sys.executable,
        [sys.executable, "-m", "genomes_agentic_os.cli", "long-run", *sys.argv[1:]],
    )


if __name__ == "__main__":
    main()
