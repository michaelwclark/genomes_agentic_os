#!/usr/bin/env python3
"""
agentic-os-notify — post a native macOS notification from any Agentic OS source.

Reads per-source config from alerts.yml (global quiet-hours + per-source settings),
delivers via terminal-notifier (if available) or osascript, and appends one JSON
line to the shared alerts log.

ENVIRONMENT
  AGENTIC_OS_ROOT   Override the installed OS root (default: ~/agentic_os).

FILES
  harness/registries/alerts.yml                    Source config (--config overrides).
  harness/shared_factory/06-runs-and-logs/alerts/alerts.jsonl   Append-only delivery log.
"""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any

import yaml

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

SCRIPT_NAME = "agentic-os-notify"
LEVEL_ORDER = {"info": 0, "warn": 1, "warning": 1, "critical": 2}
LOG_MAX_BYTES = 5 * 1024 * 1024  # 5 MB


# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def local_now(tz_name: str) -> dt.datetime:
    """Return the current wall-clock time in the given IANA timezone name."""
    try:
        import zoneinfo  # Python 3.9+
        tz = zoneinfo.ZoneInfo(tz_name)
    except Exception:
        # Fallback: use UTC offset from system if zoneinfo unavailable.
        tz = dt.timezone.utc
    return dt.datetime.now(tz)


def parse_time(s: str) -> tuple[int, int]:
    """Parse 'HH:MM' -> (hour, minute)."""
    h, m = s.strip().split(":")
    return int(h), int(m)


def level_int(level: str) -> int:
    return LEVEL_ORDER.get(level.lower(), 1)


def in_quiet_hours(global_cfg: dict[str, Any], level: str) -> bool:
    """
    Returns True when the current local time falls inside the configured quiet
    window AND the notification level is below the override threshold.
    """
    if not global_cfg.get("enabled", True):
        return False

    quiet = global_cfg.get("quiet_hours", "")
    if not quiet:
        return False

    tz_name = global_cfg.get("timezone", "America/Chicago")
    override_level = global_cfg.get("quiet_hours_override_level", "critical")

    # If this level is >= the override level it fires even during quiet hours.
    if level_int(level) >= level_int(override_level):
        return False

    try:
        start_str, end_str = quiet.split("-")
        sh, sm = parse_time(start_str)
        eh, em = parse_time(end_str)
    except ValueError:
        return False

    now = local_now(tz_name)
    current_minutes = now.hour * 60 + now.minute
    start_minutes = sh * 60 + sm
    end_minutes = eh * 60 + em

    if start_minutes <= end_minutes:
        # Same-day window e.g. 09:00–17:00
        return start_minutes <= current_minutes < end_minutes
    else:
        # Overnight window e.g. 23:00–07:00
        return current_minutes >= start_minutes or current_minutes < end_minutes


def rotate_log_if_needed(log_path: Path) -> None:
    """Rename log file with a date suffix when it exceeds LOG_MAX_BYTES."""
    try:
        if log_path.exists() and log_path.stat().st_size > LOG_MAX_BYTES:
            stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
            rotated = log_path.with_name(f"alerts-{stamp}.jsonl")
            log_path.rename(rotated)
    except OSError:
        pass  # Non-fatal; logging best-effort.


def append_log(log_path: Path, record: dict[str, Any]) -> None:
    """Append one JSON line to the delivery log; rotate if oversized."""
    rotate_log_if_needed(log_path)
    try:
        log_path.parent.mkdir(parents=True, exist_ok=True)
        with log_path.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(record, ensure_ascii=False) + "\n")
    except OSError as exc:
        print(f"[{SCRIPT_NAME}] WARNING: could not write log: {exc}", file=sys.stderr)


def resolve_source_config(
    alerts_cfg: dict[str, Any], source_id: str
) -> tuple[dict[str, Any], bool]:
    """
    Return (source_config_dict, is_registered).
    Falls back to 'default' section when source_id is not found.
    """
    sources: dict[str, Any] = alerts_cfg.get("sources", {})
    if source_id in sources:
        return sources[source_id], True
    default = sources.get("default", {})
    return default, False


def deliver_osascript(title: str, message: str, subtitle: str = "") -> int:
    """Post a macOS notification via osascript. Returns exit code."""
    subtitle_part = f'subtitle "{subtitle}" ' if subtitle else ""
    script = (
        f'display notification "{message}" with title "{title}" '
        f"{subtitle_part}"
    )
    result = subprocess.run(
        ["osascript", "-e", script],
        capture_output=True,
    )
    return result.returncode


def deliver_terminal_notifier(
    title: str,
    message: str,
    sound: str | None,
    sticky: bool,
    url: str | None,
    subtitle: str = "",
) -> int:
    """Post a macOS notification via terminal-notifier. Returns exit code."""
    cmd = [
        "terminal-notifier",
        "-title", title,
        "-message", message,
    ]
    if subtitle:
        cmd += ["-subtitle", subtitle]
    if sound and sound.lower() not in ("none", ""):
        cmd += ["-sound", sound]
    if sticky:
        cmd += ["-ignoreDnD"]
    if url:
        cmd += ["-open", url]
    result = subprocess.run(cmd, capture_output=True)
    return result.returncode


# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=SCRIPT_NAME,
        description=(
            "Post a native macOS notification from an Agentic OS automation or watcher.\n"
            "Reads per-source settings from alerts.yml (quiet hours, min level, sound, sticky).\n"
            "Appends one JSON line to the shared alerts log regardless of delivery outcome."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
ENVIRONMENT
  AGENTIC_OS_ROOT   Override the installed OS root (default: ~/agentic_os).

FILES
  harness/registries/alerts.yml
      Per-source alert configuration.  Pass --config to override for testing.

  harness/shared_factory/06-runs-and-logs/alerts/alerts.jsonl
      Append-only JSON-lines delivery log (rotated at 5 MB).

EXAMPLES
  # Post a critical alert from the OS doctor
  agentic-os-notify --source os.doctor --level critical \\
      --title "Agentic OS night run" --message "Alert layer online"

  # Test suppression with a custom config covering the current hour
  agentic-os-notify --source watchers.notion_work_intake --level warn \\
      --title "Test" --message "Should be suppressed" \\
      --config /tmp/test-alerts.yml

  # Post a watcher notification with a link (terminal-notifier required)
  agentic-os-notify --source watchers.slack_ingest --level info \\
      --title "New Slack item" --message "3 items queued" \\
      --url "https://app.slack.com/client"

  # Dry-run: print what would happen without delivering
  agentic-os-notify --source automation.pr_health --level warn \\
      --title "PR health" --message "2 PRs stale" --dry-run
""",
    )
    parser.add_argument("--source", required=True, help="Source ID (e.g. os.doctor, automation.pr_health).")
    parser.add_argument("--title", required=True, help="Notification title.")
    parser.add_argument("--message", required=True, help="Notification body text.")
    parser.add_argument(
        "--level",
        default="warn",
        choices=["info", "warn", "critical"],
        help="Severity level (default: warn).",
    )
    parser.add_argument("--url", default=None, help="URL to open on click (terminal-notifier only).")
    parser.add_argument(
        "--config",
        default=None,
        help="Path to an alternative alerts.yml (useful for testing).",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print what would happen; do not deliver the notification or write the log.",
    )
    return parser


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()

    # Resolve installed OS root.
    os_root = Path(os.environ.get("AGENTIC_OS_ROOT", Path.home() / "agentic_os")).expanduser()

    # Resolve config path.
    if args.config:
        config_path = Path(args.config).expanduser()
    else:
        config_path = os_root / "harness" / "registries" / "alerts.yml"

    # Load alerts config.
    if not config_path.exists():
        print(
            f"[{SCRIPT_NAME}] ERROR: alerts config not found: {config_path}",
            file=sys.stderr,
        )
        return 1

    try:
        with config_path.open("r", encoding="utf-8") as fh:
            alerts_cfg: dict[str, Any] = yaml.safe_load(fh) or {}
    except Exception as exc:
        print(f"[{SCRIPT_NAME}] ERROR: failed to parse {config_path}: {exc}", file=sys.stderr)
        return 1

    global_cfg: dict[str, Any] = alerts_cfg.get("global", {})
    source_cfg, is_registered = resolve_source_config(alerts_cfg, args.source)

    # Log path.
    log_path = (
        os_root
        / "harness"
        / "shared_factory"
        / "06-runs-and-logs"
        / "alerts"
        / "alerts.jsonl"
    )

    # Build base log record.
    log_record: dict[str, Any] = {
        "ts": utc_now(),
        "source": args.source,
        "level": args.level,
        "title": args.title,
        "registered": is_registered,
    }

    # --- Global enabled check ---
    if not global_cfg.get("enabled", True):
        reason = "global_disabled"
        log_record["outcome"] = "suppressed"
        log_record["reason"] = reason
        if args.dry_run:
            print(f"[dry-run] suppressed: {reason}")
        else:
            append_log(log_path, log_record)
        return 0

    # --- Per-source enabled check ---
    if not source_cfg.get("enabled", True):
        reason = "source_disabled"
        log_record["outcome"] = "suppressed"
        log_record["reason"] = reason
        if args.dry_run:
            print(f"[dry-run] suppressed: {reason}")
        else:
            append_log(log_path, log_record)
        return 0

    # --- Min level check ---
    min_level = source_cfg.get("min_level", "warn")
    if level_int(args.level) < level_int(min_level):
        reason = f"below_min_level({min_level})"
        log_record["outcome"] = "suppressed"
        log_record["reason"] = reason
        if args.dry_run:
            print(f"[dry-run] suppressed: {reason}")
        else:
            append_log(log_path, log_record)
        return 0

    # --- Quiet hours check ---
    if in_quiet_hours(global_cfg, args.level):
        reason = "quiet_hours"
        log_record["outcome"] = "suppressed"
        log_record["reason"] = reason
        if args.dry_run:
            print(f"[dry-run] suppressed: {reason}")
        else:
            append_log(log_path, log_record)
        return 0

    # --- Delivery ---
    sound: str | None = source_cfg.get("sound", None)
    sticky: bool = bool(source_cfg.get("sticky", False))

    # Use source ID as subtitle so the user knows which automation fired.
    subtitle = args.source

    if args.dry_run:
        has_tn = bool(shutil.which("terminal-notifier"))
        driver = "terminal-notifier" if has_tn else "osascript"
        print(
            f"[dry-run] would deliver via {driver}: "
            f"title={args.title!r} message={args.message!r} "
            f"level={args.level} sound={sound!r} sticky={sticky} url={args.url!r}"
        )
        return 0

    # Attempt delivery.
    rc = 1
    driver_used = "none"

    if shutil.which("terminal-notifier"):
        rc = deliver_terminal_notifier(
            title=args.title,
            message=args.message,
            sound=sound,
            sticky=sticky,
            url=args.url,
            subtitle=subtitle,
        )
        driver_used = "terminal-notifier"
        if rc != 0:
            # Fall back to osascript.
            rc = deliver_osascript(args.title, args.message, subtitle=subtitle)
            driver_used = "osascript(fallback)"
    else:
        rc = deliver_osascript(args.title, args.message, subtitle=subtitle)
        driver_used = "osascript"

    if rc == 0:
        log_record["outcome"] = "delivered"
        log_record["driver"] = driver_used
    else:
        log_record["outcome"] = "delivery_error"
        log_record["driver"] = driver_used
        log_record["exit_code"] = rc

    if args.url:
        log_record["url"] = args.url

    # Track unregistered sources so config can be extended later.
    if not is_registered:
        log_record["note"] = f"unregistered_source:{args.source} — add to alerts.yml sources section"
        print(
            f"[{SCRIPT_NAME}] WARNING: unknown source '{args.source}'; used 'default' config. "
            "Add it to harness/registries/alerts.yml.",
            file=sys.stderr,
        )

    append_log(log_path, log_record)

    return 0 if rc == 0 else rc


if __name__ == "__main__":
    sys.exit(main())
