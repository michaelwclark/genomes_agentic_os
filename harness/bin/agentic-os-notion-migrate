#!/usr/bin/env python3
"""agentic-os-notion-migrate — Keep Genome's Notion aligned with the configured IA.

Reads the IA contract (notion-organization.yml) and the ID registry
(notion-surfaces.yml), crawls the live workspace, and reports drift:
unexpected workspace roots, misplaced managed surfaces, missing surfaces,
and stale pages. Plan mode is read-only and is the nightly cleanliness check.

The public Notion API cannot move pages between parents, so placement fixes
are reported for the operator (or an MCP session) to apply. Trash mode can
remove approved junk (backup first, Notion trash, recoverable ~30 days).

ENVIRONMENT
  GENOMES_NOTION_PAT        Notion integration token (checked first).
  GENOMES_NOTION_CONNECTOR  Alternative Notion token (checked second).
  AGENTIC_OS_ROOT           Installed OS root (fallback for --root). Default: ~/agentic_os.

CONFIG FILES (read at runtime)
  harness/shared_factory/00-control-plane/notion-organization.yml  IA contract.
  harness/registries/notion-surfaces.yml                           Slug -> page ID registry.

REPORTS (written by plan mode)
  harness/shared_factory/06-runs-and-logs/notion-org/<ts>-drift.md and .json

EXAMPLES
  # Nightly drift check (read-only; exit 0 clean, 2 drift found)
  agentic-os-notion-migrate plan

  # Drift check + push a notification when drift is found
  agentic-os-notion-migrate plan --notify

  # Trash approved junk pages (backs up block content first)
  agentic-os-notion-migrate trash --ids <id1>,<id2> --live
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

try:
    import yaml
except ImportError:
    print("ERROR: PyYAML is required. Install with: pip install pyyaml", file=sys.stderr)
    sys.exit(1)

NOTION_API = "https://api.notion.com/v1"
NOTION_VERSION = "2022-06-28"
ORG_CONFIG_REL = "harness/shared_factory/00-control-plane/notion-organization.yml"
SURFACES_REL = "harness/registries/notion-surfaces.yml"
REPORT_DIR_REL = "harness/shared_factory/06-runs-and-logs/notion-org"


def default_root() -> Path:
    return Path(os.environ.get("AGENTIC_OS_ROOT", str(Path.home() / "agentic_os")))


def notion_token() -> str | None:
    return os.environ.get("GENOMES_NOTION_PAT") or os.environ.get("GENOMES_NOTION_CONNECTOR")


def api(path: str, payload: dict | None = None, method: str | None = None, token: str | None = None):
    method = method or ("POST" if payload is not None else "GET")
    req = urllib.request.Request(
        f"{NOTION_API}{path}",
        data=json.dumps(payload).encode() if payload is not None else None,
        headers={
            "Authorization": f"Bearer {token or notion_token()}",
            "Notion-Version": NOTION_VERSION,
            "Content-Type": "application/json",
        },
        method=method,
    )
    for attempt in range(4):
        try:
            with urllib.request.urlopen(req, timeout=60) as resp:
                return json.loads(resp.read()), None
        except urllib.error.HTTPError as exc:
            if exc.code == 429 or exc.code >= 500:
                time.sleep(2 ** attempt)
                continue
            return None, f"{exc.code}: {exc.read().decode()[:300]}"
        except urllib.error.URLError as exc:
            return None, str(exc)
    return None, "retries exhausted"


def norm_id(value: str | None) -> str:
    return (value or "").replace("-", "")


def crawl_workspace() -> dict[str, dict]:
    """Return {id: item} for every page/database the token can see."""
    items: dict[str, dict] = {}
    cursor = None
    while True:
        payload: dict = {"page_size": 100}
        if cursor:
            payload["start_cursor"] = cursor
        batch, err = api("/search", payload)
        if err:
            raise RuntimeError(f"workspace crawl failed: {err}")
        for result in batch.get("results", []):
            parent = result.get("parent", {})
            ptype = parent.get("type")
            title = ""
            if result["object"] == "database":
                title = "".join(t.get("plain_text", "") for t in result.get("title", []))
            else:
                for prop in result.get("properties", {}).values():
                    if prop.get("type") == "title":
                        title = "".join(t.get("plain_text", "") for t in prop.get("title", []))
            items[norm_id(result["id"])] = {
                "object": result["object"],
                "title": title or "(untitled)",
                "parent": norm_id(parent.get(ptype)) if ptype and ptype != "workspace" else "workspace",
                "parent_type": ptype,
                "edited": result.get("last_edited_time"),
                "url": result.get("url"),
            }
        if not batch.get("has_more"):
            return items
        cursor = batch.get("next_cursor")


def compute_drift(org: dict, surfaces: dict, items: dict[str, dict], now: datetime) -> dict:
    """Pure drift computation — testable without network."""
    slug_to_id = {slug: norm_id(str(entry.get("id"))) for slug, entry in (surfaces.get("surfaces") or {}).items()}
    id_to_slug = {page_id: slug for slug, page_id in slug_to_id.items()}
    allowed_roots = {slug_to_id[s] for s in org.get("root_policy", {}).get("allowed_root_slugs", []) if s in slug_to_id}

    unexpected_roots = [
        {"id": pid, "title": item["title"], "object": item["object"]}
        for pid, item in items.items()
        if item["parent"] == "workspace" and pid not in allowed_roots
    ]

    tree_parent = {node["slug"]: node.get("parent") for node in org.get("tree", [])}
    misplaced = []
    missing = []
    for slug, parent_slug in tree_parent.items():
        if not parent_slug or slug not in slug_to_id or parent_slug not in slug_to_id:
            continue
        page_id = slug_to_id[slug]
        expected_parent = slug_to_id[parent_slug]
        item = items.get(page_id)
        if item is None:
            missing.append({"slug": slug, "id": page_id})
            continue
        # database rows / block-nested parents resolve to the page via block walk;
        # only flag when actual parent is a *different known* page or workspace root.
        actual = item["parent"]
        if actual != expected_parent and (actual == "workspace" or actual in id_to_slug):
            misplaced.append({
                "slug": slug,
                "id": page_id,
                "expected_parent": parent_slug,
                "actual_parent": id_to_slug.get(actual, actual),
            })

    stale_cfg = org.get("stale_policy", {})
    threshold = int(stale_cfg.get("threshold_days", 60))
    exempt_ids = {slug_to_id[s] for s in stale_cfg.get("exempt_subtree_slugs", []) if s in slug_to_id}

    def under_exempt(pid: str) -> bool:
        seen = set()
        cur = pid
        while cur in items and cur not in seen:
            seen.add(cur)
            parent = items[cur]["parent"]
            if parent in exempt_ids:
                return True
            cur = parent
        return False

    stale = []
    for pid, item in items.items():
        if item["object"] != "page" or item.get("parent_type") == "database_id":
            continue
        edited = item.get("edited")
        if not edited:
            continue
        age = (now - datetime.fromisoformat(edited.replace("Z", "+00:00"))).days
        if age >= threshold and not under_exempt(pid):
            stale.append({"id": pid, "title": item["title"], "age_days": age})
    stale.sort(key=lambda entry: -entry["age_days"])

    return {
        "unexpected_roots": unexpected_roots,
        "misplaced": misplaced,
        "missing_surfaces": missing,
        "stale_pages": stale,
        "counts": {
            "items_crawled": len(items),
            "unexpected_roots": len(unexpected_roots),
            "misplaced": len(misplaced),
            "missing_surfaces": len(missing),
            "stale_pages": len(stale),
        },
    }


def has_drift(drift: dict) -> bool:
    counts = drift["counts"]
    return bool(counts["unexpected_roots"] or counts["misplaced"] or counts["missing_surfaces"])


def render_report(drift: dict, now: datetime) -> str:
    counts = drift["counts"]
    lines = [
        f"# Notion IA drift report — {now.isoformat()}",
        "",
        f"Crawled {counts['items_crawled']} items.",
        f"- Unexpected workspace roots: {counts['unexpected_roots']}",
        f"- Misplaced managed surfaces: {counts['misplaced']}",
        f"- Missing managed surfaces: {counts['missing_surfaces']}",
        f"- Stale pages (report-only): {counts['stale_pages']}",
        "",
    ]
    if drift["unexpected_roots"]:
        lines.append("## Unexpected roots (move under a domain or trash)")
        for entry in drift["unexpected_roots"]:
            lines.append(f"- [{entry['object']}] {entry['title']} `{entry['id']}`")
        lines.append("")
    if drift["misplaced"]:
        lines.append("## Misplaced surfaces")
        for entry in drift["misplaced"]:
            lines.append(
                f"- `{entry['slug']}` expected under `{entry['expected_parent']}`,"
                f" found under `{entry['actual_parent']}` ({entry['id']})"
            )
        lines.append("")
    if drift["missing_surfaces"]:
        lines.append("## Missing surfaces (registry points at trashed/inaccessible pages)")
        for entry in drift["missing_surfaces"]:
            lines.append(f"- `{entry['slug']}` ({entry['id']})")
        lines.append("")
    if drift["stale_pages"]:
        lines.append(f"## Stale pages — {len(drift['stale_pages'])} over threshold (top 50)")
        for entry in drift["stale_pages"][:50]:
            lines.append(f"- {entry['age_days']}d — {entry['title']} `{entry['id']}`")
        lines.append("")
    return "\n".join(lines) + "\n"


def cmd_plan(args: argparse.Namespace) -> int:
    root = Path(args.root)
    org = yaml.safe_load((root / ORG_CONFIG_REL).read_text())
    surfaces = yaml.safe_load((root / SURFACES_REL).read_text())
    if not notion_token():
        print("ERROR: no Notion token (GENOMES_NOTION_PAT / GENOMES_NOTION_CONNECTOR)", file=sys.stderr)
        return 1
    now = datetime.now(timezone.utc)
    items = crawl_workspace()
    drift = compute_drift(org, surfaces, items, now)

    report_dir = root / REPORT_DIR_REL
    report_dir.mkdir(parents=True, exist_ok=True)
    stamp = now.strftime("%Y%m%dT%H%M%SZ")
    (report_dir / f"{stamp}-drift.json").write_text(json.dumps(drift, indent=1))
    report_path = report_dir / f"{stamp}-drift.md"
    report_path.write_text(render_report(drift, now))

    print(json.dumps({"ok": not has_drift(drift), "report": str(report_path), **drift["counts"]}, indent=1))

    if args.notify and has_drift(drift):
        counts = drift["counts"]
        summary = (
            f"Notion IA drift: {counts['unexpected_roots']} unexpected roots, "
            f"{counts['misplaced']} misplaced, {counts['missing_surfaces']} missing. {report_path}"
        )
        notify = root / "harness/bin/agentic-os-notify"
        if notify.exists():
            subprocess.run([str(notify), "--source", "notion-org", "--message", summary], check=False)
    return 0 if not has_drift(drift) else 2


def cmd_trash(args: argparse.Namespace) -> int:
    root = Path(args.root)
    ids = [norm_id(value) for value in args.ids.split(",") if value.strip()]
    if not ids:
        print("ERROR: --ids is empty", file=sys.stderr)
        return 1
    backup_dir = Path(args.backup_dir) if args.backup_dir else root / REPORT_DIR_REL / "trash-backups"
    backup_dir.mkdir(parents=True, exist_ok=True)
    now = datetime.now(timezone.utc).isoformat()
    failures = 0
    for pid in ids:
        page, page_err = api(f"/pages/{pid}")
        blocks, blocks_err = api(f"/blocks/{pid}/children?page_size=100")
        (backup_dir / f"{pid}.json").write_text(json.dumps(
            {"backed_up_at": now, "page": page, "page_error": page_err,
             "blocks": blocks, "blocks_error": blocks_err}, indent=1))
        if not args.live:
            print(f"DRY-RUN would trash {pid}")
            continue
        _, err = api(f"/pages/{pid}", {"archived": True}, method="PATCH")
        if err:
            failures += 1
            print(f"FAILED {pid}: {err}", file=sys.stderr)
        else:
            print(f"TRASHED {pid} (backup: {backup_dir / (pid + '.json')})")
    return 2 if failures else 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="agentic-os-notion-migrate",
        description="Check and enforce the configured Notion IA (drift plan, guarded trash).",
        epilog=__doc__.split("ENVIRONMENT", 1)[1].join(["ENVIRONMENT", ""]) if __doc__ else None,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--root", default=str(default_root()), help="Installed OS root (default: $AGENTIC_OS_ROOT or ~/agentic_os)")
    sub = parser.add_subparsers(dest="command", required=True)

    plan = sub.add_parser("plan", help="Read-only drift check; writes report; exit 2 on drift.")
    plan.add_argument("--notify", action="store_true", help="Send agentic-os-notify alert when drift found.")
    plan.set_defaults(func=cmd_plan)

    trash = sub.add_parser("trash", help="Backup then trash approved junk pages (dry-run unless --live).")
    trash.add_argument("--ids", required=True, help="Comma-separated Notion page IDs.")
    trash.add_argument("--live", action="store_true", help="Actually trash; omit for dry-run.")
    trash.add_argument("--backup-dir", help="Backup destination (default: notion-org run logs).")
    trash.set_defaults(func=cmd_trash)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
