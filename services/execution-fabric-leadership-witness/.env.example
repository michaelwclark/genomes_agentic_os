WITNESS_TAILSCALE_IP=100.100.100.100
WITNESS_PORT=3195
WITNESS_HOST_ID=witness-1
WITNESS_CLUSTER_ID=agentic-os-production
WITNESS_STATE_FILE=/var/lib/execution-fabric-witness/witness.sqlite3
WITNESS_BOOTSTRAP_ONCE=true
WITNESS_PROCESS_LEASE_SECONDS=30
WITNESS_INITIAL_LEADER=genomesbox
WITNESS_INITIAL_TIMELINE_ID=1
WITNESS_INITIAL_CONFIG_DIGEST=replace-with-64-character-sha256
WITNESS_MAX_REPLICA_LAG_BYTES=67108864
WITNESS_CANDIDATE_FRESHNESS_SECONDS=90
WITNESS_PLAN_TTL_SECONDS=900
WITNESS_MAX_REPORT_SKEW_SECONDS=30
WITNESS_ALLOW_DEGRADED_PRIMARY=false
WITNESS_MAX_DEGRADED_PRIMARY_SECONDS=3600
WITNESS_READER_TOKEN_FILE=/run/secrets/witness-reader-token
WITNESS_CANDIDATE_TOKENS_FILE=/run/secrets/witness-candidate-tokens.json
WITNESS_ADMIN_TOKEN_FILE=/run/secrets/witness-admin-token
WITNESS_SIGNING_PRIVATE_KEY_FILE=/run/secrets/witness-signing-private-key.pem
WITNESS_LOG_LEVEL=info
