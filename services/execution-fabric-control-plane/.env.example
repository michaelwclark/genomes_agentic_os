FABRIC_HOST=0.0.0.0
FABRIC_PORT=3180
FABRIC_HOST_ID=host-a
FABRIC_DATABASE_URL=postgresql://fabric:fabric@127.0.0.1:5432/execution_fabric
FABRIC_VALKEY_URL=redis://127.0.0.1:6379
FABRIC_QUEUE_PREFIX=agentic-os:fabric
FABRIC_LEASE_SECONDS=120
FABRIC_WORKER_TTL_SECONDS=45
FABRIC_LONG_POLL_MS=15000
FABRIC_RECONCILE_INTERVAL_MS=10000
FABRIC_METRICS_PREFIX=agentic_os_fabric_
FABRIC_POLICY_CONFIG_FILE=/etc/agentic-os/execution-fabric.yml
FABRIC_POLICY_SCHEMA_FILE=/etc/agentic-os/schemas/execution-fabric.schema.json
FABRIC_API_TOKEN_FILE=/run/secrets/fabric-api-token
FABRIC_ADMIN_TOKEN_FILE=/run/secrets/fabric-admin-token
FABRIC_RELIABILITY_SOURCE_TOKENS_FILE=/run/secrets/fabric-reliability-source-tokens.json
FABRIC_CLUSTER_ID=agentic-os-production
FABRIC_LEADERSHIP_API_BASE=https://witness.example.invalid
FABRIC_LEADERSHIP_TOKEN_FILE=/run/secrets/fabric-leadership-token
FABRIC_LEADERSHIP_CANDIDATE_TOKEN_FILE=/run/secrets/fabric-leadership-candidate-token
FABRIC_LEADERSHIP_PUBLIC_KEY_FILE=/run/secrets/fabric-leadership-public-key.pem
FABRIC_LEADERSHIP_RECEIPT_FILE=/var/lib/execution-fabric-ha/leadership.receipt.json
FABRIC_LEADERSHIP_REFRESH_MS=10000
FABRIC_LEADERSHIP_RECOVERY_HOLD_SECONDS=30
FABRIC_LOG_LEVEL=info
FABRIC_OBSERVER_INTERVAL_MS=15000
FABRIC_HEALER_INTERVAL_MS=15000
FABRIC_HEALER_COOLDOWN_SECONDS=60
FABRIC_HEALER_MAX_REPAIRS_PER_HOUR=30
FABRIC_HEALER_ALLOW_ACTIONS=reconcile_expired_attempts,reconstruct_delivery,recover_effect_claim
