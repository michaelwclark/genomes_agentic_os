{
  "name": "@genomes-agentic-os/execution-fabric-control-plane",
  "version": "0.6.0",
  "private": true,
  "description": "Portable execution-fabric control plane with PostgreSQL truth and BullMQ delivery",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "migrate": "tsx src/migrate.ts",
    "start": "npm run start:api",
    "start:api": "node dist/src/main.js",
    "start:observer": "node dist/src/observer-main.js",
    "start:healer": "node dist/src/healer-main.js",
    "start:scheduler": "node dist/src/scheduler-main.js",
    "start:gateway": "node dist/src/gateway-main.js",
    "test": "vitest run",
    "test:integration": "FABRIC_INTEGRATION_TESTS=1 vitest run tests/artifacts.integration.test.ts && FABRIC_INTEGRATION_TESTS=1 vitest run tests/integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1095.0",
    "@aws-sdk/s3-request-presigner": "3.1095.0",
    "bullmq": "5.81.2",
    "dotenv": "16.4.7",
    "fastify": "5.10.0",
    "ioredis": "5.5.0",
    "pg": "8.13.3",
    "prom-client": "15.1.3",
    "yaml": "2.9.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/pg": "8.11.11",
    "tsx": "4.23.1",
    "typescript": "5.7.3",
    "vitest": "3.2.7"
  }
}
