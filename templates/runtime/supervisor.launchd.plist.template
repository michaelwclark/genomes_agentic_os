<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent template for the Agentic OS runtime supervisor.
  Rendered and installed by installers/install-scheduler.sh.
  Placeholders ({{...}}) are substituted at install time; do not hand-edit the
  rendered copy in ~/Library/LaunchAgents — re-run the installer instead.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{LABEL}}</string>
  <key>ProgramArguments</key>
  <!--
    Run via `zsh -c` so ~/.zshenv is sourced and operator secrets (e.g.
    GENOMES_NOTION_PAT) are present. launchd does NOT source the shell profile,
    so a bare invocation cannot reach those vars and Notion writes degrade to
    drafts. The secret stays in ~/.zshenv; it is never written into this plist.
  -->
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>{{AGENTIC_OS}} runtime supervise --root {{ROOT}} --apply</string>
  </array>
  <key>StartInterval</key>
  <integer>{{INTERVAL_SECONDS}}</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>{{OUT_LOG}}</string>
  <key>StandardErrorPath</key>
  <string>{{ERR_LOG}}</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
